@*
    How a new account is activated. The Managing Director creates the account and
    gives the new user a temporary password. Signing in with it opens the screen to
    choose their own password, which activates the account.
*@
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Activate your account";
}

<h1>Activate your account</h1>
<p class="lede">Your account was created by the Managing Director, who gave you a temporary password.</p>

<ol class="steps">
    <li>
        <span class="step-no" aria-hidden="true">1</span>
        <div><strong>Sign in with the temporary password.</strong> Use your work email address.</div>
    </li>
    <li>
        <span class="step-no" aria-hidden="true">2</span>
        <div><strong>Choose your own password.</strong> At least 12 characters, with a capital letter, a small letter and a number.</div>
    </li>
    <li>
        <span class="step-no" aria-hidden="true">3</span>
        <div><strong>You are in.</strong> From then on you sign in with your own password.</div>
    </li>
</ol>

<a class="btn btn-primary btn-lg btn-block" asp-action="Login">
    Sign in with the temporary password
    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-right" /></svg>
</a>

<div class="notice notice-info auth-note">
    <svg class="ico" aria-hidden="true"><use href="#i-info" /></svg>
    <div>No temporary password yet? Ask the Managing Director to issue one from the Users screen.</div>
</div>
