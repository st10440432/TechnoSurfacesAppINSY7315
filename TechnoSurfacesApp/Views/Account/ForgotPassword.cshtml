@*
    What to do about a forgotten password. The Managing Director looks after every
    account and issues a new temporary password from the Users screen, which also
    lifts a lock. The holder then chooses their own password when they sign in.
    Nothing is emailed, so this page does not ask for an email address.
*@
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgotten password";
}

<a class="btn btn-ghost btn-sm auth-back" asp-action="Login">
    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-arrow-left" /></svg> Back to sign in
</a>

<h1>Forgotten your password?</h1>
<p class="lede">The Managing Director looks after every account, so a new password comes from them.</p>

<ol class="steps">
    <li>
        <span class="step-no" aria-hidden="true">1</span>
        <div><strong>Ask the Managing Director for a new temporary password.</strong> They issue it from the Users screen.</div>
    </li>
    <li>
        <span class="step-no" aria-hidden="true">2</span>
        <div><strong>Sign in with it.</strong> Use your work email address and the temporary password.</div>
    </li>
    <li>
        <span class="step-no" aria-hidden="true">3</span>
        <div><strong>Choose your own password.</strong> You are asked to straight away, before you can carry on.</div>
    </li>
</ol>

<a class="btn btn-primary btn-lg btn-block" asp-action="Login">Back to sign in</a>

<div class="notice notice-info auth-note">
    <svg class="ico" aria-hidden="true"><use href="#i-info" /></svg>
    <div>After five wrong passwords an account is locked for 15 minutes. A new temporary password from the Managing Director unlocks it straight away.</div>
</div>
