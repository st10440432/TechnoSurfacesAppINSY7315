@model TechnoSurfacesApp.Models.LoginViewModel
@*
    Sign in (US-26, US-27). There is no registration page and no link to one:
    accounts are created by the Managing Director. A field with a problem is
    marked with aria-invalid and tied to its message by the field tag helpers.
*@
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
    var formError = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<h1>Sign in</h1>
<p class="lede">Use the email address and password the Managing Director gave you.</p>

@if (formError is not null)
{
    <div class="notice notice-alert" role="alert" tabindex="-1" data-focus-on-load>
        <svg class="ico" aria-hidden="true"><use href="#i-alert" /></svg>
        <div>@formError</div>
    </div>
}

<form asp-action="Login" method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="field">
        <label class="label" asp-for="Email"></label>
        <input class="input" asp-for="Email" type="email" autocomplete="username" required />
        <field-error for="Email" />
    </div>

    <div class="field">
        <label class="label" asp-for="Password"></label>
        <input class="input" asp-for="Password" autocomplete="current-password" required />
        <field-error for="Password" />
        <a class="hint" asp-action="ForgotPassword">Forgotten your password?</a>
    </div>

    <div class="field check">
        <input asp-for="RememberMe" />
        <label asp-for="RememberMe"></label>
    </div>

    <button class="btn btn-primary btn-lg btn-block" type="submit">
        Sign in
        <svg class="ico ico-sm" aria-hidden="true"><use href="#i-chevron-right" /></svg>
    </button>
</form>

<div class="notice notice-info auth-note">
    <svg class="ico" aria-hidden="true"><use href="#i-lock" /></svg>
    <div>
        <strong>Accounts are created by the Managing Director.</strong>
        There is no public registration. If you need access, ask the Managing Director to create an account for you.
    </div>
</div>
