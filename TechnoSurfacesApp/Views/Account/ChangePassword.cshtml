@model TechnoSurfacesApp.Models.ChangePasswordViewModel
@*
    Shown after signing in with a temporary password from the Managing Director,
    which is how a new account is activated and how a forgotten password is
    replaced. The user chooses their own password before they can go on.
*@
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Set your password";
    var errors = ViewData.ModelState[string.Empty]?.Errors.Select(e => e.ErrorMessage).ToList() ?? new List<string>();
}

<h1>Set your password</h1>
<p class="lede">
    You signed in with a temporary password from the Managing Director.
    Choose your own password before you continue.
</p>

@if (errors.Count > 0)
{
    <div class="notice notice-alert" role="alert" tabindex="-1" data-focus-on-load>
        <svg class="ico" aria-hidden="true"><use href="#i-alert" /></svg>
        <div>
            @foreach (var e in errors)
            {
                <span class="stacked">@e</span>
            }
        </div>
    </div>
}

<form asp-action="ChangePassword" method="post" novalidate>
    <div class="field">
        <label class="label" asp-for="CurrentPassword"></label>
        <input class="input" asp-for="CurrentPassword" autocomplete="current-password" required />
        <field-error for="CurrentPassword" />
    </div>

    <div class="field">
        <label class="label" asp-for="NewPassword"></label>
        <input class="input" asp-for="NewPassword" autocomplete="new-password" required aria-describedby="new-password-hint" />
        <span class="hint" id="new-password-hint">At least 12 characters, with a capital letter, a small letter and a number.</span>
        <field-error for="NewPassword" />
    </div>

    <div class="field">
        <label class="label" asp-for="ConfirmPassword"></label>
        <input class="input" asp-for="ConfirmPassword" autocomplete="new-password" required />
        <field-error for="ConfirmPassword" />
    </div>

    <button class="btn btn-primary btn-lg btn-block" type="submit">Save password and continue</button>
</form>

<form asp-action="Logout" method="post" class="auth-secondary" data-no-busy>
    <button class="btn btn-ghost btn-sm" type="submit">Sign out</button>
</form>
