@model TechnoSurfacesApp.Models.ChangePasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Set your password";
    var errors = ViewData.ModelState[string.Empty]?.Errors.Select(e => e.ErrorMessage).ToList() ?? new List<string>();
}

<h1>Set your password</h1>
<p class="lede">
    You signed in with a temporary password from the Managing Director.
    Choose your own password before you continue.
</p>

@if (errors.Count > 0)
{
    <div class="notice notice-alert" role="alert" style="margin-bottom:18px">
        <svg class="ico"><use href="#i-alert" /></svg>
        <div>
            @foreach (var e in errors)
            {
                <div>@e</div>
            }
        </div>
    </div>
}

<form asp-action="ChangePassword" method="post">
    <div class="field">
        <label class="label" asp-for="CurrentPassword"></label>
        <input class="input" asp-for="CurrentPassword" autocomplete="current-password" />
        <span class="hint" style="color:var(--danger)" asp-validation-for="CurrentPassword"></span>
    </div>

    <div class="field">
        <label class="label" asp-for="NewPassword"></label>
        <input class="input" asp-for="NewPassword" autocomplete="new-password" />
        <div class="hint">At least 12 characters, with an upper-case letter, a lower-case letter and a number.</div>
        <span class="hint" style="color:var(--danger)" asp-validation-for="NewPassword"></span>
    </div>

    <div class="field">
        <label class="label" asp-for="ConfirmPassword"></label>
        <input class="input" asp-for="ConfirmPassword" autocomplete="new-password" />
        <span class="hint" style="color:var(--danger)" asp-validation-for="ConfirmPassword"></span>
    </div>

    <button class="btn btn-primary btn-lg btn-block" type="submit">Save password and continue</button>
</form>

<form asp-action="Logout" method="post" style="margin-top:16px;text-align:center">
    <button class="btn btn-ghost btn-sm" type="submit">Sign out</button>
</form>