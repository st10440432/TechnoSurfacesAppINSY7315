@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    Layout = "_AuthLayout";
}

<h1>Something went wrong</h1>

<div class="notice notice-info" role="alert">
    <svg class="ico" aria-hidden="true"><use href="#i-alert" /></svg>
    <div>
        <strong>The page could not be shown.</strong>
        Nothing you entered has been lost if it was saved before this page appeared.
        Try again, and if it happens again, tell the Managing Director and quote the
        reference below.
    </div>
</div>

@if (Model.ShowRequestId)
{
    <p class="mt-section">Reference: <code>@Model.RequestId</code></p>
}

<p class="mt-section">
    <a class="btn btn-secondary" href="/">Back to the start</a>
</p>