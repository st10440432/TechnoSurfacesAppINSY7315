@model TechnoSurfacesApp.Controllers.CustomerListVm
@*
    The customer list (US-15), searchable by name or Pastel account code, with a
    form to add a customer. Adding posts to /api/customers through app.js and
    opens the new customer. The list comes a page at a time, like the quote list,
    because the client's Pastel list runs to about 1 560 customers; the page links
    keep the search.
*@
@{
    var pages = Model.Page;
    var count = pages.TotalCount;
    var filtered = Model.Search is not null;
    var paged = pages.PageCount > 1;
    var range = paged ? $" Showing {pages.First} to {pages.Last}." : "";

    Dictionary<string, string> PageLink(int number)
    {
        var values = new Dictionary<string, string> { ["page"] = number.ToString() };
        if (Model.Search is { } search) values["q"] = search;
        if (Model.IncludeInactive) values["inactive"] = "true";
        return values;
    }
}

<header class="page-head">
    <div>
        <h1>Customers</h1>
        <p>The companies quotes are billed to, and the people they are addressed to.</p>
    </div>
    @if (Model.CanImport)
    {
        <div class="page-head-actions">
            <a class="btn btn-secondary" asp-action="Import">
                <svg class="ico" aria-hidden="true"><use href="#i-file" /></svg> Import from Pastel
            </a>
        </div>
    }
</header>

<div class="grid grid-main">
    <section class="card" aria-labelledby="customers-title">
        <h2 class="sr-only" id="customers-title">Customer list</h2>
        <form class="filterbar" method="get" asp-action="Index" role="search" aria-label="Find a customer" data-no-busy>
            <div class="field search">
                <label class="label" for="q">Search</label>
                <svg class="ico" aria-hidden="true"><use href="#i-search" /></svg>
                <input class="input" id="q" name="q" type="search" value="@Model.Search" aria-describedby="q-hint" />
                <span class="sr-only" id="q-hint">Searches the company name and the Pastel account code.</span>
            </div>
            <div class="field check filter-check">
                <input type="checkbox" id="inactive" name="inactive" value="true" checked="@Model.IncludeInactive" data-autosubmit />
                <label for="inactive">Include inactive customers</label>
            </div>
            <div class="btn-row">
                <button type="submit" class="btn btn-secondary">Search</button>
                @if (filtered || Model.IncludeInactive)
                {
                    <a class="btn btn-ghost" asp-action="Index">Clear</a>
                }
            </div>
        </form>

        <p class="list-count" role="status">@count customer@(count == 1 ? "" : "s")@(filtered ? $" match \"{Model.Search}\"" : "").@range</p>

        @if (count == 0)
        {
            <div class="empty">
                <svg class="ico" aria-hidden="true"><use href="#i-building" /></svg>
                <h3>@(filtered ? "No customers match" : "No customers yet")</h3>
                <p>@(filtered ? "Check the spelling, or search by the Pastel account code instead." : "Add the first customer with the form beside this list.")</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data stack">
                    <caption class="sr-only">Customers</caption>
                    <thead>
                        <tr>
                            <th scope="col">Customer</th>
                            <th scope="col">City</th>
                            <th scope="col" class="right">Active contacts</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Customers)
                        {
                            <tr>
                                <td data-label="Customer">
                                    <a class="row-link" asp-action="Details" asp-route-id="@c.Id">@c.Name</a>
                                    @if (!string.IsNullOrEmpty(c.AccountCode))
                                    {
                                        <span class="sub mono">@c.AccountCode</span>
                                    }
                                </td>
                                <td data-label="City">@(c.City ?? "Not given")</td>
                                <td data-label="Active contacts" class="right">
                                    @c.ActiveContactCount
                                    @if (c.ActiveContactCount == 0 && c.IsActive)
                                    {
                                        <span class="badge badge-warn stacked">Add a contact to quote</span>
                                    }
                                </td>
                                <td data-label="Status">
                                    @if (c.IsActive)
                                    {
                                        <span class="badge badge-good">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge">Inactive</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (paged)
            {
                <nav class="pager" aria-label="Pages of customers">
                    @if (pages.HasPrevious)
                    {
                        <a class="btn btn-secondary" asp-action="Index" asp-all-route-data="PageLink(pages.Page - 1)">Previous page</a>
                    }
                    else
                    {
                        <span></span>
                    }
                    <p class="pager-status">Page @pages.Page of @pages.PageCount</p>
                    @if (pages.HasNext)
                    {
                        <a class="btn btn-secondary" asp-action="Index" asp-all-route-data="PageLink(pages.Page + 1)">Next page</a>
                    }
                    else
                    {
                        <span></span>
                    }
                </nav>
            }
        }
    </section>

    <section class="card" aria-labelledby="add-customer-title">
        <div class="card-head">
            <svg class="ico" aria-hidden="true"><use href="#i-plus" /></svg>
            <h2 id="add-customer-title">Add a customer</h2>
        </div>
        <form class="card-body" novalidate data-api-form data-method="POST" data-url="@Url.Content("~/api/customers")"
              data-redirect-to="@(Url.Content("~/Customers/Details/") + "{id}")"
              data-success="Customer added" data-success-detail="Add the people quotes will be addressed to.">
            <partial name="_CustomerFields" model="null" />
            <button type="submit" class="btn btn-primary btn-block">Add the customer</button>
        </form>
    </section>
</div>
