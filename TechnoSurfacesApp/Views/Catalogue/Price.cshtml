@model TechnoSurfacesApp.Controllers.PriceVm
@*
    The price editor (US-23, US-24, NFR-10). A new price starts on a date and the old
    one ends the day before, so no price is overwritten and a quote keeps the price it
    was made with. Only the Managing Director changes a price; everyone else reads it.
*@
@{
    var r = Model.Row;
}

<header class="page-head">
    <div>
        <h1>@r.Colour</h1>
        <p>@r.Supplier, @r.ProductLine, @r.ThicknessMm mm. Sheet size @r.SheetSize.</p>
    </div>
    <div class="page-head-actions">
        <a class="btn btn-secondary" asp-action="Index">
            <svg class="ico" aria-hidden="true"><use href="#i-arrow-left" /></svg> Back to the catalogue
        </a>
    </div>
</header>

@if (r.IsPhasingOut && !r.IsRetired)
{
    <div class="notice notice-warn" role="note">
        <svg class="ico" aria-hidden="true"><use href="#i-alert" /></svg>
        <div><strong>Being phased out.</strong> The supplier's list marks this colour as being phased out. Check it is still available before quoting it.</div>
    </div>
}

@if (!Model.CanEdit)
{
    <partial name="_ReadOnlyNote" model="@("Only the Managing Director changes material prices. You can see the current price and every earlier one.")" />
}

@if (r.IsRetired)
{
    <div class="notice notice-warn" role="note">
        <svg class="ico" aria-hidden="true"><use href="#i-info" /></svg>
        <div><strong>Retired.</strong> This material cannot be chosen on a new quote, so its price can no longer be changed. Quotes already made keep it and its price.</div>
    </div>
}

<div class="grid grid-main">
    <div class="stack-gap">
        <section class="card" aria-labelledby="current-title">
            <div class="card-head">
                <h2 id="current-title">Price today</h2>
            </div>
            <div class="card-body">
                @if (r.PricePerSheet is { } perSheet)
                {
                    <p class="tile-value mb-0">@Fmt.Rand(perSheet) <span class="muted small">per sheet, ex VAT</span></p>
                    <p class="mb-0">@Fmt.Rand(r.PricePerSqm!.Value) per m², in force since @Fmt.Date(r.PriceFrom!.Value).</p>
                }
                else
                {
                    <div class="notice notice-alert" role="note">
                        <svg class="ico" aria-hidden="true"><use href="#i-alert" /></svg>
                        <div><strong>No price is in force today.</strong> This material cannot be quoted until it has one.</div>
                    </div>
                }
                @if (Model.IsBandPrice)
                {
                    <p class="hint">@r.Supplier prices by band. This is the price of band @r.Band, so a change here applies to every colour in that band.</p>
                }
            </div>
        </section>

        <section class="card" aria-labelledby="history-title">
            <div class="card-head">
                <svg class="ico" aria-hidden="true"><use href="#i-history" /></svg>
                <h2 id="history-title">Price history</h2>
            </div>
            @if (Model.History.Count == 0)
            {
                <div class="card-body"><p class="muted mb-0">No price has been recorded yet.</p></div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data stack">
                        <caption class="sr-only">Every price for this material, newest first</caption>
                        <thead>
                            <tr>
                                <th scope="col">From</th>
                                <th scope="col">Until</th>
                                <th scope="col" class="right">Per m²</th>
                                <th scope="col" class="right">Per sheet</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.History)
                            {
                                var current = p.From <= Model.Today && (p.To is null || p.To >= Model.Today);
                                <tr>
                                    <td data-label="From" class="nowrap">
                                        @Fmt.Date(p.From)
                                        @if (current) { <span class="badge badge-good stacked">In force today</span> }
                                        else if (p.From > Model.Today) { <span class="badge badge-info stacked">Starts later</span> }
                                    </td>
                                    <td data-label="Until" class="nowrap">@(p.To is { } to ? Fmt.Date(to) : "No end date")</td>
                                    <td data-label="Per m²" class="right num">@Fmt.Rand(p.PricePerSqm)</td>
                                    <td data-label="Per sheet" class="right num">@(Model.PerSheet(p.PricePerSqm) is { } perSheetThen ? Fmt.Rand(perSheetThen) : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    @if (Model.CanEdit && !r.IsRetired)
    {
        <div class="stack-gap">
            <section class="card" aria-labelledby="change-title">
                <div class="card-head">
                    <svg class="ico" aria-hidden="true"><use href="#i-edit" /></svg>
                    <h2 id="change-title">Change the price</h2>
                </div>
                <form class="card-body" method="post" asp-action="SetMaterialPrice">
                    <input type="hidden" name="ColourId" value="@(Model.IsBandPrice ? "" : r.ColourId.ToString())" />
                    <input type="hidden" name="PriceBandId" value="@r.PriceBandId" />
                    <input type="hidden" name="SheetSizeId" value="@r.SheetSizeId" />

                    <div class="field">
                        <label class="label" for="PricePerSqm">New price per m², ex VAT</label>
                        <span class="input-group">
                            <span class="addon before" aria-hidden="true">R</span>
                            <input class="input input-num" id="PricePerSqm" name="PricePerSqm" type="number" step="0.01" min="0.01" required
                                   inputmode="decimal" aria-describedby="price-hint" />
                        </span>
                        <span class="hint" id="price-hint">From the supplier's price list. It must be more than zero.</span>
                    </div>
                    <div class="field">
                        <label class="label" for="EffectiveFrom">Starts on</label>
                        <input class="input" id="EffectiveFrom" name="EffectiveFrom" type="date" required
                               value="@Model.Today.ToString("yyyy-MM-dd")" aria-describedby="from-hint" />
                        <span class="hint" id="from-hint">The current price ends the day before. Quotes already made keep their price.</span>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">Save the new price</button>
                </form>
            </section>

            <section class="card" aria-labelledby="retire-title">
                <div class="card-head">
                    <h2 id="retire-title">Stop quoting this colour</h2>
                </div>
                <form class="card-body" method="post" asp-action="RetireColour"
                      data-confirm="Retire @r.Colour?" data-confirm-label="Retire" data-confirm-tone="danger"
                      data-confirm-detail="It stays on quotes already made, but cannot be chosen on new ones. This cannot be undone here.">
                    <input type="hidden" name="colourId" value="@r.ColourId" />
                    <p>Retire a colour the supplier no longer sells. It is never deleted, so older quotes still read correctly.</p>
                    <button type="submit" class="btn btn-danger btn-block">Retire @r.Colour</button>
                </form>
            </section>
        </div>
    }
</div>
