@model TechnoSurfacesApp.Controllers.CatalogueVm
@*
    The material catalogue (US-23, US-24): every colour in every sheet size with the
    price in force today and the date it took effect. Everyone sees every price.
*@
@{
    var count = Model.Rows.Count;
    bool IsStale(DateOnly? from) =>
        from is { } f && Model.Today.DayNumber - f.DayNumber > TechnoSurfacesApp.Controllers.CatalogueController.StaleAfterDays;
}

<header class="page-head">
    <div>
        <h1>Material catalogue</h1>
        <p>Every material and the price it is quoted at today, from each supplier's own price list.</p>
    </div>
</header>

@if (Model.StaleSuppliers.Count > 0)
{
    <div class="notice notice-warn" role="note">
        <svg class="ico" aria-hidden="true"><use href="#i-alert" /></svg>
        <div>
            <strong>Some price lists are over a year old.</strong>
            @string.Join("; ", Model.StaleSuppliers.Select(s => $"{s.Supplier}, from {Fmt.Date(s.NewestPrice)}")).
            Check these prices with the supplier before quoting from them.
        </div>
    </div>
}

<section class="card" aria-labelledby="catalogue-title">
    <h2 class="sr-only" id="catalogue-title">Materials</h2>

    <form class="filters" method="get" asp-action="Index" role="search" aria-label="Find a material" data-no-busy>
        <div class="field">
            <label class="label" for="q">Search</label>
            <input class="input" id="q" name="q" type="search" value="@Model.Search" aria-describedby="q-hint" />
            <span class="hint" id="q-hint">Colour, supplier code, range or band.</span>
        </div>
        <div class="field">
            <label class="label" for="supplier">Supplier</label>
            <select class="select" id="supplier" name="supplier" data-autosubmit>
                <option value="">All suppliers</option>
                @foreach (var s in Model.Suppliers)
                {
                    <option value="@s" selected="@(Model.Supplier == s)">@s</option>
                }
            </select>
        </div>
        <div class="field check filter-check">
            <input type="checkbox" id="retired" name="retired" value="true" checked="@Model.IncludeRetired" data-autosubmit />
            <label for="retired">Include retired materials</label>
        </div>
        <div class="btn-row">
            <button type="submit" class="btn btn-secondary">Search</button>
            @if (Model.AnyFilter)
            {
                <a class="btn btn-ghost" asp-action="Index">Clear</a>
            }
        </div>
    </form>

    <div class="card-body">
        <p class="list-count" role="status">@count material@(count == 1 ? "" : "s")@(Model.AnyFilter ? " match" : "").</p>

        @if (count == 0)
        {
            <div class="empty">
                <svg class="ico" aria-hidden="true"><use href="#i-layers" /></svg>
                <h3>No materials match</h3>
                <p>Check the spelling, or choose All suppliers.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data stack stack-md">
                    <caption class="sr-only">Materials and their prices today</caption>
                    <thead>
                        <tr>
                            <th scope="col">Material</th>
                            <th scope="col">Supplier and range</th>
                            <th scope="col">Sheet size</th>
                            <th scope="col" class="right">Price per sheet</th>
                            <th scope="col"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td data-label="Material">
                                    <span class="strong">@r.Colour</span>
                                    @if (!string.IsNullOrEmpty(r.SupplierCode))
                                    {
                                        <span class="sub mono">@r.SupplierCode</span>
                                    }
                                    @if (r.IsRetired)
                                    {
                                        <span class="badge stacked">Retired</span>
                                    }
                                    else if (r.IsPhasingOut)
                                    {
                                        <span class="badge badge-warn stacked">Being phased out</span>
                                    }
                                </td>
                                <td data-label="Supplier and range">
                                    @r.Supplier
                                    <span class="sub">@r.ProductLine, @r.ThicknessMm mm@(r.Band is null ? "" : $", band {r.Band}")</span>
                                </td>
                                <td data-label="Sheet size">@r.SheetSize</td>
                                <td data-label="Price per sheet" class="right num">
                                    @if (r.PricePerSheet is { } sheet)
                                    {
                                        <span class="strong">@Fmt.Rand(sheet)</span>
                                        <span class="sub">@Fmt.Rand(r.PricePerSqm!.Value) per m², since @Fmt.Date(r.PriceFrom!.Value)</span>
                                        @if (IsStale(r.PriceFrom))
                                        {
                                            <span class="badge badge-warn stacked">Price list over a year old</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">No price</span>
                                    }
                                </td>
                                <td data-label="Actions" class="right">
                                    <a class="btn btn-ghost btn-sm" asp-action="Price" asp-route-colourId="@r.ColourId" asp-route-sheetSizeId="@r.SheetSizeId">
                                        Price history<span class="sr-only"> for @r.Colour, @r.SheetSize</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
