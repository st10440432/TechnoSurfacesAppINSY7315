@* The layout for pages a signed-out visitor can reach: sign in, password reset,
   account activation and the error page. It reads nothing about the user, so it
   renders even when no one is signed in. *@
<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] &middot; Techno Surfaces</title>
    <link rel="icon" type="image/jpeg" href="~/img/logo.jpg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <partial name="_Icons" />

    <div class="auth">
        <main class="auth-panel" id="main" tabindex="-1">
            <div class="auth-form">
                @RenderBody()
            </div>
        </main>

        <aside class="auth-brand" aria-label="About the quoting system">
            <span class="brand-logo-sm">
                <img src="~/img/techno-surfaces-logo.jpg" alt="Techno Surfaces" width="2000" height="475" />
            </span>

            <p class="auth-headline">Every price traced to its source.</p>
            <p class="auth-sub">
                Supplier catalogue, costing sheet and customer quotation in one place,
                so a wrong number can never pass for a right one.
            </p>

            <ul class="auth-points">
                <li><svg class="ico ico-sm" aria-hidden="true"><use href="#i-check" /></svg> Live pricing from all five suppliers</li>
                <li><svg class="ico ico-sm" aria-hidden="true"><use href="#i-check" /></svg> Quotes keep the price they were created with</li>
                <li><svg class="ico ico-sm" aria-hidden="true"><use href="#i-check" /></svg> Cost prices never reach a customer document</li>
                <li><svg class="ico ico-sm" aria-hidden="true"><use href="#i-check" /></svg> A full record of every change</li>
            </ul>

            <p class="auth-foot">Techno Surfaces (Pty) Ltd &middot; Epping 2, Cape Town</p>
        </aside>
    </div>

    <div class="toasts" id="toasts" role="status" aria-live="polite"></div>
    <div class="toasts" id="toasts-urgent" role="alert" aria-live="assertive"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
