@using TechnoSurfaces.Application.Auditing
@model IReadOnlyList<AuditRow>
@*
    US-19: what changed on this quote, by whom and when, written as sentences.
    The newest few show straight away; the rest open on request.
*@
@{
    var stories = ChangeStories.From(Model);
    const int shown = 6;
}

<section class="card" aria-labelledby="changes-title">
    <div class="card-head">
        <svg class="ico" aria-hidden="true"><use href="#i-history" /></svg>
        <h2 id="changes-title">Changes to this quote</h2>
    </div>

    @if (stories.Count == 0)
    {
        <div class="card-body">
            <p class="muted mb-0">No changes recorded yet.</p>
        </div>
    }
    else
    {
        <div class="card-body">
            <ol class="changes">
                @foreach (var s in stories.Take(shown))
                {
                    <partial name="_ChangeStory" model="s" />
                }
            </ol>

            @if (stories.Count > shown)
            {
                <details class="disclosure changes-more">
                    <summary class="btn btn-ghost btn-sm">Show @(stories.Count - shown) earlier change@(stories.Count - shown == 1 ? "" : "s")</summary>
                    <ol class="changes">
                        @foreach (var s in stories.Skip(shown))
                        {
                            <partial name="_ChangeStory" model="s" />
                        }
                    </ol>
                </details>
            }
        </div>
    }
</section>
