@model string
@*
    The show or hide button beside a password field. The model is the id of the
    input it controls. wirePasswordToggles() in app.js does the switching, and
    the field goes back to hidden before the form is sent so the browser's
    password manager still offers to save it.
*@
<button type="button" class="addon addon-btn" data-password-toggle="@Model" aria-controls="@Model" aria-pressed="false" aria-label="Show password">
    <svg class="ico" aria-hidden="true"><use href="#i-eye" /></svg>
</button>
