@model TechnoSurfacesApp.Controllers.DashboardVm
@{
    var pending = Model.Count("PendingApproval");
    var drafts = Model.Count("Draft");
}

<header class="page-head">
    <div>
        <h1>Good day, @Model.FirstName</h1>
        @if (Model.IsManagingDirector)
        {
            <p>@(Model.Queue.Count == 0 ? "No quotes are waiting for your approval." : $"{Model.Queue.Count} quote{(Model.Queue.Count == 1 ? " is" : "s are")} waiting for your approval.")</p>
        }
        else
        {
            <p>@(drafts == 0 ? "You have no drafts in progress." : $"You have {drafts} draft{(drafts == 1 ? "" : "s")} in progress.")</p>
        }
    </div>
    <div class="page-head-actions">
        <a class="btn btn-primary" asp-controller="Quotes" asp-action="Create">
            <svg class="ico" aria-hidden="true"><use href="#i-plus" /></svg> New quote
        </a>
        <a class="btn btn-secondary" asp-controller="Quotes" asp-action="Index">All quotes</a>
    </div>
</header>

@if (Model.StaleSuppliers.Count > 0)
{
    <div class="notice notice-warn" role="note">
        <svg class="ico" aria-hidden="true"><use href="#i-alert" /></svg>
        <div>
            <strong>@Model.StaleSuppliers.Count supplier price list@(Model.StaleSuppliers.Count == 1 ? " is" : "s are") more than a year old.</strong>
            @string.Join(", ", Model.StaleSuppliers.Select(s => $"{s.Name} ({Fmt.Date(s.PriceListDated)})")).
            Check the prices with the supplier before quoting from @(Model.StaleSuppliers.Count == 1 ? "it" : "them").
            <a asp-controller="Catalogue" asp-action="Index">Open the catalogue</a>
        </div>
    </div>
}

<section aria-labelledby="summary-title">
    <h2 class="sr-only" id="summary-title">Summary</h2>
    <div class="grid grid-4 mb-section">
        @if (Model.IsManagingDirector)
        {
            <div class="tile tile-accent amber">
                <div class="tile-label">Waiting for your approval</div>
                <div class="tile-value">@Model.Queue.Count</div>
                <div class="tile-note">@Fmt.Rand(Model.Queue.Sum(q => q.TotalExVat)) ex VAT</div>
            </div>
        }
        else
        {
            <div class="tile tile-accent amber">
                <div class="tile-label">Waiting for approval</div>
                <div class="tile-value">@pending</div>
                <div class="tile-note">submitted to the Managing Director</div>
            </div>
        }
        <div class="tile tile-accent navy">
            <div class="tile-label">Drafts in progress</div>
            <div class="tile-value">@drafts</div>
            <div class="tile-note">@Fmt.Rand(Model.Value("Draft")) ex VAT</div>
        </div>
        <div class="tile tile-accent blue">
            <div class="tile-label">Out with customers</div>
            <div class="tile-value">@Model.Count("Sent")</div>
            <div class="tile-note">
                @if (Model.ExpiringSoon > 0)
                {
                    <span class="badge badge-warn">@Model.ExpiringSoon expiring within 7 days</span>
                }
                else
                {
                    @:None expiring this week
                }
            </div>
        </div>
        <div class="tile tile-accent">
            <div class="tile-label">Accepted</div>
            <div class="tile-value">@Model.Count("Accepted")</div>
            <div class="tile-note">@Fmt.Rand(Model.Value("Accepted")) ex VAT</div>
        </div>
    </div>
</section>

<div class="grid grid-main">
    <div class="stack-gap">
        @if (Model.IsManagingDirector)
        {
            <section class="card" aria-labelledby="queue-title">
                <div class="card-head">
                    <svg class="ico" aria-hidden="true"><use href="#i-inbox" /></svg>
                    <h2 id="queue-title">Approval queue</h2>
                    <span class="spacer"></span>
                    <a class="btn btn-secondary btn-sm" asp-controller="Quotes" asp-action="Approvals">Open the queue</a>
                </div>
                @if (Model.Queue.Count == 0)
                {
                    <div class="empty">
                        <svg class="ico" aria-hidden="true"><use href="#i-check-circle" /></svg>
                        <h3>Nothing is waiting</h3>
                        <p>When an estimator submits a quote it appears here, oldest first.</p>
                    </div>
                }
                else
                {
                    <partial name="_QuoteTable" model='new QuoteTable(Model.Queue.Take(5).ToList(), "Quotes waiting for approval", ShowValidity: false, ShowWaiting: true, LinkToReview: true)' />
                }
            </section>
        }

        <section class="card" aria-labelledby="recent-title">
            <div class="card-head">
                <svg class="ico" aria-hidden="true"><use href="#i-file" /></svg>
                <h2 id="recent-title">@(Model.IsManagingDirector ? "Recent quotes" : "Your quotes")</h2>
                <span class="spacer"></span>
                <a class="btn btn-secondary btn-sm" asp-controller="Quotes" asp-action="Index">View all</a>
            </div>
            @if (Model.Recent.Count == 0)
            {
                <div class="empty">
                    <svg class="ico" aria-hidden="true"><use href="#i-file" /></svg>
                    <h3>No quotes yet</h3>
                    <p>Start a quote and it appears here. The material price fills in from the supplier's own price list.</p>
                    <a class="btn btn-primary" asp-controller="Quotes" asp-action="Create">Start a quote</a>
                </div>
            }
            else
            {
                <partial name="_QuoteTable" model='new QuoteTable(Model.Recent, "Recent quotes", ShowAuthor: Model.IsManagingDirector)' />
            }
        </section>
    </div>

    <div class="stack-gap">
        @if (Model.IsManagingDirector)
        {
            <section class="card" aria-labelledby="activity-title">
                <div class="card-head">
                    <svg class="ico" aria-hidden="true"><use href="#i-history" /></svg>
                    <h2 id="activity-title">Recent changes</h2>
                </div>
                @if (Model.Activity.Count == 0)
                {
                    <div class="card-body"><p class="muted small">No changes have been recorded yet.</p></div>
                }
                else
                {
                    <ul class="activity">
                        @foreach (var a in Model.Activity)
                        {
                            <li>
                                <span class="avatar @(a.IsPriceChange ? "warn" : "")" aria-hidden="true">@string.Concat(a.UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]))</span>
                                <div>
                                    <span class="strong">@a.UserName</span>
                                    <span>@a.Action.ToLowerInvariant() @a.PropertyName on @a.EntityName @a.EntityKey</span>
                                    @if (a.OldValue is not null || a.NewValue is not null)
                                    {
                                        <span class="sub">
                                            @if (a.OldValue is not null) { <del>@a.OldValue</del> <span aria-hidden="true">&rarr;</span><span class="sr-only">changed to</span> }
                                            <ins>@(a.NewValue ?? "removed")</ins>
                                        </span>
                                    }
                                    <span class="sub">@Fmt.DateTimeShort(a.ChangedAtLocal)</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
                <div class="card-foot">
                    <a class="btn btn-ghost btn-sm" asp-controller="Admin" asp-action="Audit">Open the audit trail</a>
                </div>
            </section>
        }

        <section class="card" aria-labelledby="pipeline-title">
            <div class="card-head"><h2 id="pipeline-title">Where quotes are</h2></div>
            <div class="card-body">
                @{ var max = Math.Max(1, StatusText.All.Max(s => Model.Count(s))); }
                <ul class="pipeline">
                    @foreach (var s in StatusText.All)
                    {
                        var n = Model.Count(s);
                        <li>
                            <span class="pipeline-label">@StatusText.Label(s)</span>
                            <span class="pipeline-bar" aria-hidden="true"><span style="--fill:@(n * 100 / max)%"></span></span>
                            <span class="pipeline-count">@n</span>
                        </li>
                    }
                </ul>
                <p class="sub">Catalogue: @Model.SupplierCount suppliers.</p>
            </div>
        </section>
    </div>
</div>
