@model TechnoSurfacesApp.Controllers.ApprovalsVm
@*
    The approval queue (US-17): quotes waiting for the Managing Director, oldest
    first, with customer, project and value. An estimator who opens it sees the
    same list read only, with a note saying who works it, not an error page.
*@

<header class="page-head">
    <div>
        <h1>Approval queue</h1>
        <p>Quotes waiting for approval, oldest first.</p>
    </div>
</header>

@if (!Model.CanApprove)
{
    <partial name="_ReadOnlyNote" model="@("Only the Managing Director approves quotes. You can see what is waiting, but approving is done from the Managing Director's account.")" />
}

<section class="card" aria-labelledby="queue-title">
    <div class="card-head">
        <svg class="ico" aria-hidden="true"><use href="#i-inbox" /></svg>
        <h2 id="queue-title">Waiting for approval</h2>
        <span class="spacer"></span>
        @if (Model.Queue.Count > 0)
        {
            <span class="badge">@Model.Queue.Count waiting, @Fmt.Rand(Model.Queue.Sum(q => q.TotalExVat)) ex VAT</span>
        }
    </div>

    @if (Model.Queue.Count == 0)
    {
        <div class="empty">
            <svg class="ico" aria-hidden="true"><use href="#i-check-circle" /></svg>
            <h3>Nothing is waiting</h3>
            <p>When an estimator submits a quote it appears here, oldest first.</p>
        </div>
    }
    else
    {
        <partial name="_QuoteTable" model='new QuoteTable(Model.Queue, "Quotes waiting for approval", ShowValidity: false, ShowWaiting: true, LinkToReview: true)' />
    }
</section>
