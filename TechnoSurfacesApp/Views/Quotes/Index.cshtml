@model TechnoSurfacesApp.Controllers.QuoteListVm
@*
    Every quote, filtered by status, customer, author or a search. The filters are
    an ordinary GET form, so a filtered list has its own address that can be
    bookmarked or shared, and it works without JavaScript. The list comes a page
    at a time; the page links keep the filters.
*@
@{
    var pages = Model.Page;
    var count = pages.TotalCount;
    var paged = pages.PageCount > 1;
    var range = paged ? $" Showing {pages.First} to {pages.Last}." : "";

    // The filters as they stand, for the page links.
    Dictionary<string, string> PageLink(int number)
    {
        var values = new Dictionary<string, string> { ["page"] = number.ToString() };
        if (Model.Search is { } search) values["q"] = search;
        if (Model.Status is { } status) values["status"] = status;
        if (Model.CustomerId is { } customerId) values["customerId"] = customerId.ToString();
        if (Model.Mine) values["mine"] = "true";
        return values;
    }
}

<header class="page-head">
    <div>
        <h1>Quotes</h1>
        <p>Every quote, newest first. Open one to see its costing sheet.</p>
    </div>
    <div class="page-head-actions">
        <a class="btn btn-primary" asp-action="Create">
            <svg class="ico" aria-hidden="true"><use href="#i-plus" /></svg> New quote
        </a>
    </div>
</header>

<section class="card" aria-labelledby="list-title">
    <h2 class="sr-only" id="list-title">Quote list</h2>

    <form class="filterbar" method="get" asp-action="Index" role="search" aria-label="Filter the quotes" data-no-busy>
        <div class="field search">
            <label class="label" for="q">Search</label>
            <svg class="ico" aria-hidden="true"><use href="#i-search" /></svg>
            <input class="input" id="q" name="q" type="search" value="@Model.Search" aria-describedby="q-hint" />
            <span class="sr-only" id="q-hint">Searches the reference, customer, site and project.</span>
        </div>
        <div class="field">
            <label class="label" for="status">Status</label>
            <select class="select" id="status" name="status" data-autosubmit>
                <option value="">All statuses</option>
                @foreach (var s in StatusText.All)
                {
                    <option value="@s" selected="@(Model.Status == s)">@StatusText.Label(s)</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="label" for="customerId">Customer</label>
            <select class="select" id="customerId" name="customerId" data-autosubmit>
                <option value="">All customers</option>
                @foreach (var c in Model.Customers)
                {
                    <option value="@c.Id" selected="@(Model.CustomerId == c.Id)">@c.Name@(c.IsActive ? "" : " (inactive)")</option>
                }
            </select>
        </div>
        <div class="field check filter-check">
            <input type="checkbox" id="mine" name="mine" value="true" checked="@Model.Mine" data-autosubmit />
            <label for="mine">Only my quotes</label>
        </div>
        <div class="btn-row">
            <button type="submit" class="btn btn-secondary">Apply</button>
            @if (Model.AnyFilter)
            {
                <a class="btn btn-ghost" asp-action="Index">Clear filters</a>
            }
        </div>
    </form>

    <p class="list-count" role="status">
        @if (Model.AnyFilter)
        {
            @:@count quote@(count == 1 ? "" : "s") match the filters.@range
        }
        else
        {
            @:@count quote@(count == 1 ? "" : "s").@range
        }
    </p>

    @if (count == 0 && Model.AnyFilter)
    {
        <div class="empty">
            <svg class="ico" aria-hidden="true"><use href="#i-search" /></svg>
            <h3>No quotes match</h3>
            <p>Try a different status or customer, or clear the filters to see every quote.</p>
            <a class="btn btn-secondary" asp-action="Index">Clear filters</a>
        </div>
    }
    else if (count == 0)
    {
        <div class="empty">
            <svg class="ico" aria-hidden="true"><use href="#i-file" /></svg>
            <h3>No quotes yet</h3>
            <p>Start the first quote. The material prices fill in from the suppliers' own price lists.</p>
            <a class="btn btn-primary" asp-action="Create">Start a quote</a>
        </div>
    }
    else
    {
        <partial name="_QuoteTable" model='new QuoteTable(Model.Quotes, "Quotes", ShowCustomer: Model.CustomerId is null)' />

        @if (paged)
        {
            <nav class="pager" aria-label="Pages of quotes">
                @if (pages.HasPrevious)
                {
                    <a class="btn btn-secondary" asp-action="Index" asp-all-route-data="PageLink(pages.Page - 1)">Previous page</a>
                }
                else
                {
                    <span></span>
                }
                <p class="pager-status">Page @pages.Page of @pages.PageCount</p>
                @if (pages.HasNext)
                {
                    <a class="btn btn-secondary" asp-action="Index" asp-all-route-data="PageLink(pages.Page + 1)">Next page</a>
                }
                else
                {
                    <span></span>
                }
            </nav>
        }
    }
</section>
