@model TechnoSurfacesApp.Controllers.ReviewVm
@{
    var q = Model.Quote;
    var groups = TechnoSurfacesApp.Controllers.CostingVm.Order;

    string GroupName(RateGroup g) => g switch
    {
        RateGroup.Fabrication => "Fabrication",
        RateGroup.Consumables => "Consumables",
        RateGroup.Installation => "Installation",
        RateGroup.WoodSubstrate => "Wood & substrate",
        RateGroup.SinksHardware => "Sinks & hardware",
        _ => "Below the line"
    };
}

<div class="page-head">
    <div>
        <h2>Review quote</h2>
        <p>@q.Project &middot; submitted by @Db.UserName(q.OwnerUserId)</p>
    </div>
    <div class="page-head-actions">
        <a class="btn btn-secondary" asp-action="Approvals">
            <svg class="ico ico-sm"><use href="#i-arrow-left" /></svg> Queue
        </a>
        <a class="btn btn-secondary" asp-action="Quotation" asp-route-id="@q.Id">
            <svg class="ico ico-sm"><use href="#i-eye" /></svg> Customer view
        </a>
    </div>
</div>

<partial name="_QuoteHeader" model="q" />

<div class="grid grid-main">
    <div>
        <div class="card">
            <div class="card-head">
                <svg class="ico" style="color:var(--ts-sage)"><use href="#i-layers" /></svg>
                <h2>Materials and resolved prices</h2>
            </div>
            <div class="table-wrap">
                <table class="data stack">
                    <thead>
                        <tr>
                            <th>Material</th>
                            <th>Size</th>
                            <th class="right">Sheets</th>
                            <th class="right">m&sup2;</th>
                            <th class="right">R/sheet</th>
                            <th class="right">Disc</th>
                            <th class="right">Line total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in q.MaterialLines)
                        {
                            <tr>
                                <td data-label="Material">
                                    <div class="strong">@m.ColourName</div>
                                    <div class="tiny muted">
                                        @m.SupplierName &middot; @m.ProductLineName
                                        @if (m.BandCode is not null)
                                        {
                                            <span class="badge badge-band">@m.BandCode</span>
                                        }
                                    </div>
                                    <div class="tiny muted">
                                        @(string.IsNullOrEmpty(m.SupplierCode) ? "No supplier code" : m.SupplierCode)
                                        &middot; price resolved @Fmt.Date(m.PriceResolvedAt)
                                    </div>
                                </td>
                                <td data-label="Size" class="nowrap">@m.SizeLabel</td>
                                <td data-label="Sheets" class="right">@Fmt.Qty(m.SheetsToOrder)</td>
                                <td data-label="m&sup2;" class="right">@Fmt.Num(m.SquareMetres)</td>
                                <td data-label="R/sheet" class="right">@Fmt.Rand(m.ResolvedPricePerSheet)</td>
                                <td data-label="Disc" class="right">
                                    @(m.SupplierDiscountPct > 0 ? Fmt.Pct(m.SupplierDiscountPct) : "\u2014")
                                </td>
                                <td data-label="Line total" class="right strong">@Fmt.Rand(m.LineTotal)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="total-row">
                            <td colspan="6">Material subtotal</td>
                            <td class="right">@Fmt.Rand(q.MaterialTotal)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-head">
                <svg class="ico" style="color:var(--ts-blue)"><use href="#i-calc" /></svg>
                <h2>Cost breakdown by section</h2>
            </div>
            <div class="table-wrap">
                <table class="data stack">
                    <thead>
                        <tr>
                            <th>Section</th>
                            <th class="right">Lines</th>
                            <th class="right">Total</th>
                            <th>Marked up</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in groups)
                        {
                            var rows = q.CostingLines.Where(l => l.Group == g && l.Quantity > 0).ToList();
                            if (rows.Count == 0)
                            {
                                continue;
                            }

                            <tr>
                                <td data-label="Section">
                                    <div class="strong">@GroupName(g)</div>
                                    <div class="tiny muted">
                                        @string.Join(", ", rows.Take(3).Select(r => r.Name))@(rows.Count > 3 ? $" +{rows.Count - 3} more" : "")
                                    </div>
                                </td>
                                <td data-label="Lines" class="right">@rows.Count</td>
                                <td data-label="Total" class="right strong">@Fmt.Rand(rows.Sum(r => r.LineTotal))</td>
                                <td data-label="Marked up">
                                    @if (g == RateGroup.BelowTheLine)
                                    {
                                        <span class="badge badge-warn">No &mdash; cost recovery</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-sage">Yes</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-foot">
                <a class="btn btn-secondary btn-sm" asp-action="Costing" asp-route-id="@q.Id">
                    Open full costing sheet
                    <svg class="ico ico-sm"><use href="#i-chevron-right" /></svg>
                </a>
            </div>
        </div>
    </div>

    <div>
        <div class="card totals">
            <div class="card-head"><h3>Pre-approval checks</h3></div>
            <div class="card-body" style="padding:6px 20px">
                @foreach (var c in Model.Checks)
                {
                    var icon = c.Level == "ok" ? "#i-check" : c.Level == "warn" ? "#i-alert" : "#i-info";
                    <div class="check-row">
                        <span class="check-dot check-@c.Level">
                            <svg class="ico" style="width:11px;height:11px;flex-basis:11px">
                                <use href="@icon" />
                            </svg>
                        </span>
                        <span class="check-body">
                            <span class="check-title">@c.Title</span>
                            <span class="check-detail">@c.Detail</span>
                        </span>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-head"><h3>Figures</h3></div>
            <div class="card-body">
                <div class="totals-row">
                    <span class="lbl">Sub total</span>
                    <span class="val">@Fmt.Rand(q.SubTotal)</span>
                </div>
                <div class="totals-row">
                    <span class="lbl">Markup @Fmt.Pct(q.MarkupPct)</span>
                    <span class="val">@Fmt.Rand(q.MarkupAmount)</span>
                </div>
                <div class="totals-row">
                    <span class="lbl">Below the line</span>
                    <span class="val">@Fmt.Rand(q.BelowTheLineTotal)</span>
                </div>
                <div class="totals-row grand">
                    <span class="lbl">Total</span>
                    <span class="val">@Fmt.Rand(q.Total)</span>
                </div>
                <div class="totals-note">
                    @Fmt.Area(q.TotalSqm) at <strong>@Fmt.Rand(q.RandPerSqm) per m&sup2;</strong>.
                    Use this as the range check before approving.
                            @await Component.InvokeAsync("QuoteChanges", new { reference = q.Ref })
                </div>
            </div>

            @if (Model.IsMd)
            {
                <div class="card-foot" style="display:block">
                    <button class="btn btn-primary btn-block" type="button">
                        <svg class="ico ico-sm"><use href="#i-check" /></svg> Approve quote
                    </button>
                    <a class="btn btn-secondary btn-block" asp-action="Costing" asp-route-id="@q.Id"
                       style="margin-top:9px">
                        <svg class="ico ico-sm"><use href="#i-edit" /></svg> Correct, then approve
                    </a>
                    <p class="hint" style="margin-top:10px;margin-bottom:0">
                        Approving locks the quote against further estimator edits.
                    </p>
                </div>
            }
            else
            {
                <div class="card-foot">
                    <span class="small muted">
                        <svg class="ico ico-sm" style="vertical-align:-2px"><use href="#i-lock" /></svg>
                        Only the Managing Director can approve.
                    </span>
                </div>
            }
        </div>
    </div>
</div>