@model TechnoSurfacesApp.Controllers.ReviewVm
@*
    Review a quote before approving it (US-18, US-19). The checks say what is
    ready and what is not; the costing is shown with where every price came from;
    the changes made to the quote are listed. The Managing Director can correct the
    costing or the quotation and then approve, without sending it back.
*@
@{
    var q = Model.Quote;
    var a = Model.Actions;
    var t = Model.Sheet.Totals;
    var check = Model.Check;
    var lines = Model.Sheet.Lines;
    var changedPrices = lines.Count(l => l.HasPriceOverride);
    var enteredPrices = lines.Count(l => l.PriceOrigin == TechnoSurfaces.Application.Quoting.CostingSheetService.EnteredOnQuoteOrigin);
    var typedOver = lines.Count(l => l.IsQuantityOverridden);
}

<header class="page-head">
    <div>
        <h1>Review quote</h1>
        <p>@q.Reference for @q.CustomerName, submitted by @q.AuthorName.</p>
    </div>
    <div class="page-head-actions">
        @if (a.CanEdit)
        {
            <a class="btn btn-secondary" asp-action="Costing" asp-route-id="@q.Id">
                <svg class="ico" aria-hidden="true"><use href="#i-edit" /></svg> Correct the costing
            </a>
        }
        <a class="btn btn-secondary" asp-action="Quotation" asp-route-id="@q.Id">
            <svg class="ico" aria-hidden="true"><use href="#i-file" /></svg> @(a.CanEdit ? "Correct the quotation" : "Customer quotation")
        </a>
    </div>
</header>

<partial name="_QuoteHeader" model="q" />
<partial name="_QuoteTabs" model="q" />

@if (!a.IsManagingDirector)
{
    <partial name="_ReadOnlyNote" model="@("Only the Managing Director approves quotes. You can read the review, and any changes the Managing Director makes are listed here.")" />
}
else if (q.Status != "PendingApproval")
{
    <div class="notice notice-info" role="note">
        <svg class="ico" aria-hidden="true"><use href="#i-info" /></svg>
        <div>This quote is <strong>@StatusText.Label(q.Status).ToLowerInvariant()</strong>, so there is nothing to approve.</div>
    </div>
}

<div class="grid grid-main">
    <div class="stack-gap">
        <section class="card" aria-labelledby="checks-title">
            <div class="card-head">
                <svg class="ico" aria-hidden="true"><use href="#i-check-circle" /></svg>
                <h2 id="checks-title">Before approving</h2>
            </div>
            <div class="card-body">
                <ul class="check-list">
                    <li class="check-row">
                        @if (q.CostingLineCount > 0)
                        {
                            <span class="check-dot check-ok" aria-hidden="true"><svg class="ico ico-sm"><use href="#i-check" /></svg></span>
                            <span class="check-body">
                                <span class="check-title">Costed</span>
                                <span class="check-detail">@q.CostingLineCount line@(q.CostingLineCount == 1 ? "" : "s"), every one priced. A line without a price cannot be saved.</span>
                            </span>
                        }
                        else
                        {
                            <span class="check-dot check-warn" aria-hidden="true"><svg class="ico ico-sm"><use href="#i-alert" /></svg></span>
                            <span class="check-body">
                                <span class="check-title">Nothing costed</span>
                                <span class="check-detail">The quote has no costing lines.</span>
                            </span>
                        }
                    </li>
                    @if (check is not null)
                    {
                        <li><partial name="_QuotationCheck" model="check" /></li>
                    }
                    <li class="check-row">
                        @if (changedPrices + enteredPrices + typedOver == 0)
                        {
                            <span class="check-dot check-ok" aria-hidden="true"><svg class="ico ico-sm"><use href="#i-check" /></svg></span>
                            <span class="check-body">
                                <span class="check-title">Prices as listed</span>
                                <span class="check-detail">Every price comes from a supplier's price list or the rate card, and no calculated quantity was typed over.</span>
                            </span>
                        }
                        else
                        {
                            <span class="check-dot check-info" aria-hidden="true"><svg class="ico ico-sm"><use href="#i-info" /></svg></span>
                            <span class="check-body">
                                <span class="check-title">Worth a look</span>
                                <span class="check-detail">
                                    @string.Join(" ", new[]
                                    {
                                        changedPrices > 0 ? $"{changedPrices} rate{(changedPrices == 1 ? " was" : "s were")} changed for this quote." : null,
                                        enteredPrices > 0 ? $"{enteredPrices} price{(enteredPrices == 1 ? " was" : "s were")} entered on the quote because the rate card has none." : null,
                                        typedOver > 0 ? $"{typedOver} calculated quantit{(typedOver == 1 ? "y was" : "ies were")} typed over." : null
                                    }.Where(s => s is not null))
                                    They are marked in the costing below.
                                </span>
                            </span>
                        }
                    </li>
                    <li class="check-row">
                        <span class="check-dot @(q.ExpiresSoon ? "check-warn" : "check-ok")" aria-hidden="true">
                            <svg class="ico ico-sm"><use href="#@(q.ExpiresSoon ? "i-alert" : "i-check")" /></svg>
                        </span>
                        <span class="check-body">
                            <span class="check-title">Valid until @Fmt.Date(q.ValidUntil)</span>
                            <span class="check-detail">@(q.ExpiresSoon ? $"Only {q.DaysRemaining} day{(q.DaysRemaining == 1 ? "" : "s")} left to send it." : $"{q.DaysRemaining} days left.")</span>
                        </span>
                    </li>
                </ul>
            </div>
        </section>

        <section class="card" aria-labelledby="costing-title">
            <div class="card-head">
                <svg class="ico" aria-hidden="true"><use href="#i-calc" /></svg>
                <h2 id="costing-title">The costing</h2>
                <span class="spacer"></span>
                <span class="badge">For Techno Surfaces only</span>
            </div>
            <partial name="_MaterialLines" model="new TechnoSurfacesApp.Controllers.CostingLinesVm(Model.Sheet, false)" />
            <partial name="_RateLines" model="new TechnoSurfacesApp.Controllers.CostingLinesVm(Model.Sheet, false)" />
        </section>
    </div>

    <div class="stack-gap">
        <section class="card" aria-labelledby="review-totals-title">
            <div class="card-head"><h2 id="review-totals-title">Totals</h2></div>
            <div class="card-body">
                <div class="totals-row"><span class="lbl">Sub total</span><span class="val">@Fmt.Rand(t.SubTotalExVat)</span></div>
                <div class="totals-row"><span class="lbl">Markup @Fmt.Pct(t.MarkupPercent)</span><span class="val">@Fmt.Rand(t.MarkupAmount)</span></div>
                <div class="totals-row"><span class="lbl">Cut-outs, grooves and transport</span><span class="val">@Fmt.Rand(t.BelowTheLineTotal)</span></div>
                <div class="totals-row total-line"><span class="lbl">Total ex VAT</span><span class="val">@Fmt.Rand(t.TotalExVat)</span></div>
                <div class="totals-row"><span class="lbl">VAT at @Fmt.Pct(t.VatRate * 100)</span><span class="val">@Fmt.Rand(t.VatAmount)</span></div>
                <div class="totals-row grand"><span class="lbl">Total inc VAT</span><span class="val">@Fmt.Rand(t.TotalIncVat)</span></div>
                <dl class="facts facts-tight">
                    <dt>Total area</dt><dd>@Fmt.Sqm(t.TotalAreaM2)</dd>
                    <dt>Sheets</dt><dd>@Fmt.Qty(t.TotalSheetCount)</dd>
                    <dt>Rand per m², ex VAT</dt><dd>@(t.TotalAreaM2 > 0 ? Fmt.Rand(t.TotalExVat / t.TotalAreaM2) : "Not yet")</dd>
                </dl>
            </div>
        </section>

        <partial name="_QuoteActions" model="new TechnoSurfacesApp.Controllers.QuoteActionBar(q, a, check)" />

        @await Component.InvokeAsync("QuoteChanges", new { reference = q.Reference })
    </div>
</div>
