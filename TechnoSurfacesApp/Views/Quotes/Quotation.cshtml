@model TechnoSurfacesApp.Controllers.QuotationVm
@*
    The customer quotation (US-10 to US-14). The document is bound only to
    CustomerQuotation, which has no cost price, supplier discount or markup on it,
    so none can appear here: not on screen, not in the markup, not in an attribute
    (US-11). The editor above it, which is never printed, writes the lines the
    customer reads and shows whether they add up to the costing.
*@
@{
    var d = Model.Document;
    var h = d.Header;
    var a = Model.Actions;
    var check = Model.Check;
    var canEditLines = a.CanEdit;
    var toAllocate = check is null ? 0m : -check.Difference;
    var bill = Model.IsBillOfQuantities;
    var extras = Model.AllowanceAmount + Model.TransportAmount;
}

<header class="page-head no-print">
    <div>
        <h1>Customer quotation</h1>
        <p>@h.Reference for @h.Company. Version @d.VersionNo.</p>
    </div>
    <div class="page-head-actions">
        <button type="button" class="btn btn-secondary" data-print>
            <svg class="ico" aria-hidden="true"><use href="#i-print" /></svg> Print or save as PDF
        </button>
    </div>
</header>

<div class="no-print">
    <partial name="_QuoteHeader" model="Model.Quote" />
    <partial name="_QuoteTabs" model="Model.Quote" />

    <div class="notice notice-good" role="note">
        <svg class="ico" aria-hidden="true"><use href="#i-check-circle" /></svg>
        <div>
            <strong>Safe to send.</strong> This page is built only from the customer's lines, the standing terms and the warranties.
            No cost price, supplier discount or markup is on it anywhere.
        </div>
    </div>

    @if (!d.IsIssued)
    {
        <div class="notice notice-info" role="note">
            <svg class="ico" aria-hidden="true"><use href="#i-info" /></svg>
            <div>
                <strong>Not issued yet.</strong> The terms below are today's standing terms. When the quote is approved they are recorded
                with it, so a later change to the terms does not alter this quotation.
            </div>
        </div>
    }

    @if (!d.BankDetailsSet)
    {
        <div class="notice notice-warn" role="note">
            <svg class="ico" aria-hidden="true"><use href="#i-alert" /></svg>
            <div>
                <strong>No banking details.</strong> The Managing Director has not entered them on the quotation terms screen,
                so the quotation says they have not been entered.
            </div>
        </div>
    }

    @if (canEditLines && check is not null)
    {
        <section class="card" aria-labelledby="layout-title">
            <div class="card-head">
                <svg class="ico" aria-hidden="true"><use href="#i-file" /></svg>
                <h2 id="layout-title">How the quotation lists the work</h2>
            </div>
            <div class="card-body stack-gap">
                <form data-api-form data-method="PUT" data-url="@Url.Content($"~/api/quotes/{d.QuoteId}/quotation/layout")"
                      data-success="Layout changed">
                    <fieldset>
                        <legend class="sr-only">Layout of the quotation</legend>
                        <label class="check">
                            <input type="radio" name="layout" value="Lines" checked="@(!bill)" data-autosubmit aria-describedby="layout-lines-hint" />
                            <span>
                                Lines written for the customer
                                <span class="hint" id="layout-lines-hint">One line per room or element, as for a kitchen or a vanity.</span>
                            </span>
                        </label>
                        <label class="check">
                            <input type="radio" name="layout" value="BillOfQuantities" checked="@bill" data-autosubmit aria-describedby="layout-bill-hint" />
                            <span>
                                Bill of quantities
                                <span class="hint" id="layout-bill-hint">
                                    As a tender is sent: each item with its number, description, unit, quantity, rate and amount, under its section.
                                    Built from the items on the costing sheet, so it always adds up to the costing.
                                </span>
                            </span>
                        </label>
                    </fieldset>
                </form>

                @if (bill)
                {
                    <p class="hint">
                        The items' numbers, names, units, sections and quantities are changed on the
                        <a asp-action="Costing" asp-route-id="@d.QuoteId">costing sheet</a>.
                        Allowance @Fmt.Rand(Model.AllowanceAmount) and transport @Fmt.Rand(Model.TransportAmount) are typed there too.
                    </p>
                    <form data-api-form data-method="PUT" data-url="@Url.Content($"~/api/quotes/{d.QuoteId}/quotation/layout")"
                          data-success="@(Model.SpreadAllowances ? "Listed on their own lines" : "Spread over the items")">
                        <label class="check">
                            <input type="checkbox" id="spread-allowances" name="spreadAllowances" value="true" checked="@Model.SpreadAllowances" data-autosubmit
                                   aria-describedby="spread-hint" />
                            <span>
                                Spread the allowance and transport over the items' rates
                                <span class="hint" id="spread-hint">
                                    Each item carries a share in proportion to its amount, as on the client's tenders.
                                    Off, they are listed after the items on lines of their own.
                                    @if (extras == 0)
                                    {
                                        @:There is no allowance or transport on this quote yet.
                                    }
                                </span>
                            </span>
                        </label>
                    </form>
                    @if (!Model.SpreadAllowances)
                    {
                        <form novalidate data-api-form data-method="PUT" data-url="@Url.Content($"~/api/quotes/{d.QuoteId}/quotation/layout")"
                              data-success="Wording saved">
                            <div class="field">
                                <label class="label" for="allowance-description">The allowance on the quotation</label>
                                <input class="input" id="allowance-description" name="allowanceDescription" required
                                       maxlength="@TechnoSurfaces.Domain.Quoting.QuoteVersion.AllowanceDescriptionMaxLength"
                                       value="@Model.AllowanceDescription" />
                            </div>
                            <button type="submit" class="btn btn-secondary">Save the wording</button>
                        </form>
                    }
                }
            </div>
        </section>
    }

    @if (canEditLines && check is not null && !bill)
    {
        <section class="card" aria-labelledby="lines-editor-title" id="quotation-editor"
                 data-api="@Url.Content($"~/api/quotes/{d.QuoteId}/")"
                 data-to-allocate="@Fmt.Input(toAllocate)">
            <div class="card-head">
                <svg class="ico" aria-hidden="true"><use href="#i-edit" /></svg>
                <h2 id="lines-editor-title">Lines the customer reads</h2>
            </div>
            <div class="card-body">
                <partial name="_QuotationCheck" model="check" />
                <p class="hint">
                    Write one line for each room or element, with its size, material and colour, as the customer would describe it.
                    The lines must add up to the costing total of @Fmt.Rand(check.CostingTotalExVat) ex VAT before the quote can be approved.
                </p>
                @if (Model.Quote.CostingLineCount > 0)
                {
                    <div class="from-costing">
                        <button type="button" class="btn btn-secondary"
                                data-api-action data-method="POST" data-url="@Url.Content($"~/api/quotes/{d.QuoteId}/quotation-lines/from-costing")"
                                data-confirm="Add the materials from the costing sheet?"
                                data-confirm-detail="@(d.Lines.Count == 0
                                    ? "Each material becomes a line at its selling price, and the labour, consumables and extras become one more line, so the lines add up to the costing total. You can change or remove any of them afterwards."
                                    : "A material already on the quotation is brought up to date, not added again. Any material not on it yet, and the labour, consumables and extras if they are not, are added after the lines already here. Lines written by hand are left as they are.")"
                                data-confirm-label="Add the lines"
                                data-success="Lines brought up to date with the costing"
                                data-success-detail="Check the descriptions read the way the customer would describe the work."
                                aria-describedby="from-costing-hint">
                            <svg class="ico" aria-hidden="true"><use href="#i-copy" /></svg> Add the materials from the costing sheet
                        </button>
                        <span class="hint" id="from-costing-hint">
                            One line per material at its selling price, and one line for the labour, consumables and extras. No cost price or markup is shown.
                            Lines copied from the costing change with it: a new price, quantity, discount or markup on the costing sheet shows here at once.
                        </span>
                        <form class="check" data-api-form data-method="PUT" data-url="@Url.Content($"~/api/quotes/{d.QuoteId}/quotation/sheet-counts")"
                              data-success="@(Model.ShowSheetCounts ? "Sheet counts taken off" : "Sheet counts shown")"
                              data-success-detail="@(Model.ShowSheetCounts ? "Each material line is one item again." : "Each material line copied from the costing gives its number of sheets.")">
                            <input type="checkbox" id="show-sheet-counts" name="showSheetCounts" value="true" checked="@Model.ShowSheetCounts" data-autosubmit
                                   aria-describedby="sheet-counts-hint" />
                            <label for="show-sheet-counts">
                                Show the number of sheets on material lines
                                <span class="hint" id="sheet-counts-hint">Off, each material is one item, as the customer reads brand, colour and thickness only.</span>
                            </label>
                        </form>
                    </div>
                }
            </div>

            @if (d.Lines.Count > 0)
            {
                <div class="table-wrap">
                    <table class="data stack">
                        <caption class="sr-only">Lines on the quotation, in the order the customer reads them</caption>
                        <thead>
                            <tr>
                                <th scope="col">Item</th>
                                <th scope="col">Description</th>
                                <th scope="col" class="right">Qty</th>
                                <th scope="col" class="right">Amount ex VAT</th>
                                <th scope="col"><span class="sr-only">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < d.Lines.Count; i++)
                            {
                                var l = d.Lines[i];
                                <tr data-quotation-line="@l.Id" data-room="@l.Room" data-description="@l.Description"
                                    data-quantity="@Fmt.Input(l.Quantity)" data-amount="@Fmt.Input(l.AmountExVat)">
                                    <td data-label="Item">@(l.Room ?? "No item")</td>
                                    <td data-label="Description" class="pre-line">@l.Description</td>
                                    <td data-label="Qty" class="right">@Fmt.Qty(l.Quantity)</td>
                                    <td data-label="Amount ex VAT" class="right strong">@Fmt.Rand(l.AmountExVat)</td>
                                    <td data-label="Actions" class="right nowrap">
                                        <button type="button" class="btn btn-ghost btn-sm btn-icon" data-move="up" disabled="@(i == 0)"
                                                aria-label="Move @(l.Room ?? "line " + (i + 1)) up">
                                            <svg class="ico" aria-hidden="true"><use href="#i-arrow-up" /></svg>
                                        </button>
                                        <button type="button" class="btn btn-ghost btn-sm btn-icon" data-move="down" disabled="@(i == d.Lines.Count - 1)"
                                                aria-label="Move @(l.Room ?? "line " + (i + 1)) down">
                                            <svg class="ico" aria-hidden="true"><use href="#i-arrow-down" /></svg>
                                        </button>
                                        <button type="button" class="btn btn-ghost btn-sm btn-icon" data-edit-line
                                                aria-label="Change @(l.Room ?? "line " + (i + 1))">
                                            <svg class="ico" aria-hidden="true"><use href="#i-edit" /></svg>
                                        </button>
                                        <button type="button" class="btn btn-ghost btn-sm btn-icon" data-delete-line
                                                aria-label="Remove @(l.Room ?? "line " + (i + 1))">
                                            <svg class="ico" aria-hidden="true"><use href="#i-trash" /></svg>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <form class="card-body card-body-top" id="quotation-line-form" novalidate data-no-busy aria-labelledby="line-form-title">
                <h3 class="section-label" id="line-form-title" data-add-title="Add a line" data-edit-title="Change the line">Add a line</h3>
                <div class="field-row field-row-2">
                    <div class="field">
                        <label class="label" for="line-room">Item <span class="optional">optional</span></label>
                        <input class="input" id="line-room" name="room" maxlength="120" aria-describedby="line-room-hint" />
                        <span class="hint" id="line-room-hint">The room or element, such as Kitchen island.</span>
                    </div>
                    <div class="field-row field-row-2">
                        <div class="field">
                            <label class="label" for="line-quantity">Qty</label>
                            <input class="input input-num" id="line-quantity" name="quantity" type="number" inputmode="decimal" min="0" step="any" value="1" required />
                        </div>
                        <div class="field">
                            <label class="label" for="line-amount">Amount ex VAT</label>
                            <span class="input-group">
                                <span class="addon before" aria-hidden="true">R</span>
                                <input class="input input-num" id="line-amount" name="amountExVat" type="number" inputmode="decimal" min="0" step="any" required />
                            </span>
                        </div>
                    </div>
                </div>
                <div class="field">
                    <label class="label" for="line-description">Description</label>
                    <textarea class="input" id="line-description" name="description" rows="3" maxlength="400" required
                              aria-describedby="line-description-hint"></textarea>
                    <span class="hint" id="line-description-hint">What was made and where, with sizes, material and colour. Up to 400 characters.</span>
                </div>
                <div class="btn-row">
                    <button type="submit" class="btn btn-primary" data-add-label="Add the line" data-edit-label="Save the line">Add the line</button>
                    @if (toAllocate > 0)
                    {
                        <button type="button" class="btn btn-secondary" data-fill-remaining>
                            Use the amount still to allocate, @Fmt.Rand(toAllocate)
                        </button>
                    }
                    <button type="button" class="btn btn-ghost" data-cancel-edit hidden>Cancel</button>
                </div>
            </form>
        </section>
    }
    else if (!canEditLines && !bill && d.Lines.Count == 0)
    {
        <div class="notice notice-warn" role="note">
            <svg class="ico" aria-hidden="true"><use href="#i-alert" /></svg>
            <div><strong>No lines yet.</strong> The estimator has not written the lines the customer reads.</div>
        </div>
    }
</div>

@* ======================= The document ======================= *@
<partial name="_QuotationDocument" model="d" />

@section Scripts {
    @if (canEditLines && !bill)
    {
        <script src="~/js/quotation.js" asp-append-version="true"></script>
    }
}
