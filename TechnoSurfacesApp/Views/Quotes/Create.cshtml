@model TechnoSurfacesApp.Controllers.NewQuoteVm
@*
    A new quote (US-14, US-15): who it is for, where the work is, and the markup.
    Posted to QuotesController.Create, which creates it through the quote workflow
    service and opens its costing sheet. A field with a problem is marked with
    aria-invalid and tied to its message by the field tag helpers.
*@
@{
    var f = Model.Form;
    var noCustomers = Model.Customers.Count == 0;
    ViewData["ErrorOrder"] = new[]
    {
        "Form.CustomerId", "Form.ContactId", "Form.CustomerReference", "Form.Site", "Form.Project",
        "Form.DeliveryAddress", "Form.Reference", "Form.MarkupPercent", "Form.ValidForDays"
    };
}

<header class="page-head">
    <div>
        <h1>New quote</h1>
        <p>Start with who the quote is for and where the work is. The materials and labour come next, on the costing sheet.</p>
    </div>
</header>

@if (noCustomers)
{
    <div class="empty card">
        <svg class="ico" aria-hidden="true"><use href="#i-building" /></svg>
        <h2>Add a customer first</h2>
        <p>A quote is billed to a customer and addressed to one of its contacts. There are no active customers with contacts yet.</p>
        <a class="btn btn-primary" asp-controller="Customers" asp-action="Index">Open customers</a>
    </div>
}
else
{
    <form method="post" asp-action="Create" class="content-narrow" novalidate>
        <partial name="_ErrorSummary" />

        <section class="card" aria-labelledby="who-title">
            <div class="card-head">
                <svg class="ico" aria-hidden="true"><use href="#i-building" /></svg>
                <h2 id="who-title">Who it is for</h2>
            </div>
            <div class="card-body">
                <div class="field-row field-row-2">
                    <div class="field">
                        <label class="label" asp-for="Form.CustomerId">Customer <span class="req" aria-hidden="true">*</span></label>
                        <select class="select" asp-for="Form.CustomerId" required data-customer-select>
                            <option value="">Choose a customer</option>
                            @foreach (var c in Model.Customers)
                            {
                                <option value="@c.Id" selected="@(f.CustomerId == c.Id)">@c.Name@(string.IsNullOrEmpty(c.AccountCode) ? "" : $" ({c.AccountCode})")</option>
                            }
                        </select>
                        <field-error for="Form.CustomerId" />
                    </div>
                    <div class="field">
                        <label class="label" asp-for="Form.ContactId">Attention of <span class="req" aria-hidden="true">*</span></label>
                        <select class="select" asp-for="Form.ContactId" required aria-describedby="contact-hint" data-contact-select>
                            <option value="">Choose a contact</option>
                            @foreach (var c in Model.Customers)
                            {
                                foreach (var p in c.Contacts)
                                {
                                    <option value="@p.Id" data-customer="@c.Id" data-name="@p.FullName@(string.IsNullOrEmpty(p.Position) ? "" : ", " + p.Position)"
                                            selected="@(f.ContactId == p.Id)">@c.Name: @p.FullName@(string.IsNullOrEmpty(p.Position) ? "" : ", " + p.Position)</option>
                                }
                            }
                        </select>
                        <span class="hint" id="contact-hint">The person the quotation is addressed to.</span>
                        <field-error for="Form.ContactId" />
                    </div>
                </div>
                <div class="field">
                    <label class="label" asp-for="Form.CustomerReference">Customer's own reference <span class="optional">optional</span></label>
                    <input class="input" asp-for="Form.CustomerReference" maxlength="100" aria-describedby="custref-hint" />
                    <span class="hint" id="custref-hint">Their order or job number, if they gave one. It is printed on the quotation.</span>
                    <field-error for="Form.CustomerReference" />
                </div>
            </div>
        </section>

        <section class="card" aria-labelledby="where-title">
            <div class="card-head">
                <svg class="ico" aria-hidden="true"><use href="#i-file" /></svg>
                <h2 id="where-title">The job</h2>
            </div>
            <div class="card-body">
                <div class="field-row field-row-2">
                    <div class="field">
                        <label class="label" asp-for="Form.Site">Site <span class="optional">optional</span></label>
                        <input class="input" asp-for="Form.Site" maxlength="200" aria-describedby="site-hint" />
                        <span class="hint" id="site-hint">Where the work is done.</span>
                        <field-error for="Form.Site" />
                    </div>
                    <div class="field">
                        <label class="label" asp-for="Form.Project">Project <span class="optional">optional</span></label>
                        <input class="input" asp-for="Form.Project" maxlength="200" aria-describedby="project-hint" />
                        <span class="hint" id="project-hint">What the job is, such as Kitchen and scullery.</span>
                        <field-error for="Form.Project" />
                    </div>
                </div>
                <div class="field">
                    <label class="label" asp-for="Form.DeliveryAddress">Delivery address <span class="optional">optional</span></label>
                    <textarea class="input" asp-for="Form.DeliveryAddress" rows="2" maxlength="300"></textarea>
                    <field-error for="Form.DeliveryAddress" />
                </div>
            </div>
        </section>

        <section class="card" aria-labelledby="terms-title">
            <div class="card-head">
                <svg class="ico" aria-hidden="true"><use href="#i-sliders" /></svg>
                <h2 id="terms-title">Reference, markup and validity</h2>
            </div>
            <div class="card-body">
                <div class="field-row field-row-3">
                    <div class="field">
                        <label class="label" asp-for="Form.Reference">Quote reference <span class="req" aria-hidden="true">*</span></label>
                        <input class="input" asp-for="Form.Reference" maxlength="40" required autocomplete="off" aria-describedby="reference-hint" />
                        <span class="hint" id="reference-hint">
                            Each quote needs its own reference.@if (Model.LastReference is not null)
                            {
                                <text> The last one used was <span class="mono">@Model.LastReference</span>.</text>
                            }
                        </span>
                        <field-error for="Form.Reference" />
                    </div>
                    <div class="field">
                        <label class="label" asp-for="Form.MarkupPercent">Markup <span class="req" aria-hidden="true">*</span></label>
                        <span class="input-group">
                            <input class="input input-num" asp-for="Form.MarkupPercent" type="text" inputmode="decimal" required aria-describedby="markup-hint" />
                            <span class="addon" aria-hidden="true">%</span>
                        </span>
                        <span class="hint" id="markup-hint">Applied to the sub total only. There is no default, so enter it for every quote.</span>
                        <field-error for="Form.MarkupPercent" />
                    </div>
                    <div class="field">
                        <label class="label" asp-for="Form.ValidForDays">Valid for <span class="req" aria-hidden="true">*</span></label>
                        <span class="input-group">
                            <input class="input input-num" asp-for="Form.ValidForDays" type="number" inputmode="numeric" min="1" max="365" required aria-describedby="valid-hint" />
                            <span class="addon">days</span>
                        </span>
                        <span class="hint" id="valid-hint">The standing terms give 30 days.</span>
                        <field-error for="Form.ValidForDays" />
                    </div>
                </div>
                <p class="hint mb-0">Fields marked <span class="req">*</span> are required.</p>
            </div>
        </section>

        <div class="form-actions">
            <a class="btn btn-ghost" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-primary">
                Create the quote and open the costing sheet
            </button>
        </div>
    </form>
}

@section Scripts {
    <script src="~/js/quote-create.js" asp-append-version="true"></script>
}
