@model TechnoSurfacesApp.Controllers.InvoiceVm
@*
    The Sage Pastel invoice recorded against an accepted quote (US-25). Pastel
    raises the invoice; this records its number, date and amount beside what was
    quoted, so the two can be reconciled. The form posts to the invoice API
    through app.js.
*@
@{
    var q = Model.Quote;
    var r = Model.Recorded;
}

<header class="page-head">
    <div>
        <h1>Invoice record</h1>
        <p>@q.Reference for @q.CustomerName. The invoice is raised in Sage Pastel and recorded here.</p>
    </div>
</header>

<partial name="_QuoteHeader" model="q" />
<partial name="_QuoteTabs" model="q" />

<div class="grid grid-main">
    @if (r is not null)
    {
        <section class="card" aria-labelledby="recorded-title">
            <div class="card-head">
                <svg class="ico" aria-hidden="true"><use href="#i-check-circle" /></svg>
                <h2 id="recorded-title">Invoice @r.InvoiceNumber</h2>
            </div>
            <div class="card-body">
                <dl class="facts">
                    <dt>Invoice number</dt>
                    <dd class="mono">@r.InvoiceNumber</dd>
                    <dt>Invoice date</dt>
                    <dd>@Fmt.Date(r.InvoiceDate)</dd>
                    <dt>Invoiced, inc VAT</dt>
                    <dd>@Fmt.Rand(r.AmountIncVat)</dd>
                    <dt>Quoted, inc VAT</dt>
                    <dd>@Fmt.Rand(r.QuotedTotalIncVat)</dd>
                    <dt>Difference</dt>
                    <dd>
                        @if (r.Variance == 0)
                        {
                            <span class="badge badge-good">None. The invoice matches the quote.</span>
                        }
                        else
                        {
                            <span class="badge badge-warn">@Fmt.Rand(Math.Abs(r.Variance)) @(r.Variance > 0 ? "more" : "less") than quoted</span>
                            <span class="sub">Usual when the job was re-measured on site or changed.</span>
                        }
                    </dd>
                    <dt>Recorded</dt>
                    <dd>@Fmt.DateTimeShort(TechnoSurfaces.Application.Auditing.AuditTime.ToLocal(r.RecordedAtUtc))</dd>
                </dl>
            </div>
        </section>
    }
    else if (Model.CanRecord)
    {
        <section class="card" aria-labelledby="record-title">
            <div class="card-head">
                <svg class="ico" aria-hidden="true"><use href="#i-copy" /></svg>
                <h2 id="record-title">Record the Pastel invoice</h2>
            </div>
            <form class="card-body" novalidate
                  data-api-form data-method="POST" data-url="@Url.Content($"~/api/quotes/{q.Id}/invoice")"
                  data-success="Invoice recorded" data-success-detail="It is now beside the quote, with any difference worked out.">
                <div class="field-row field-row-3">
                    <div class="field">
                        <label class="label" for="invoiceNumber">Invoice number <span class="req" aria-hidden="true">*</span></label>
                        <input class="input mono" id="invoiceNumber" name="invoiceNumber" required autocomplete="off" aria-describedby="invoiceNumber-hint" />
                        <span class="hint" id="invoiceNumber-hint">As printed on the Pastel invoice.</span>
                    </div>
                    <div class="field">
                        <label class="label" for="invoiceDate">Invoice date <span class="req" aria-hidden="true">*</span></label>
                        <input class="input" id="invoiceDate" name="invoiceDate" type="date" required />
                    </div>
                    <div class="field">
                        <label class="label" for="amountIncVat">Amount inc VAT <span class="req" aria-hidden="true">*</span></label>
                        <span class="input-group">
                            <span class="addon before" aria-hidden="true">R</span>
                            <input class="input input-num" id="amountIncVat" name="amountIncVat" type="number" inputmode="decimal" min="0.01" step="any" required aria-describedby="amount-hint" />
                        </span>
                        <span class="hint" id="amount-hint">The quote came to @Fmt.Rand(q.Totals.TotalIncVat) including VAT.</span>
                    </div>
                </div>
                <div class="btn-row">
                    <button type="submit" class="btn btn-primary">Record the invoice</button>
                </div>
            </form>
        </section>
    }
    else
    {
        <section class="card" aria-labelledby="not-yet-title">
            <div class="empty">
                <svg class="ico" aria-hidden="true"><use href="#i-info" /></svg>
                <h2 id="not-yet-title">Not yet</h2>
                <p>An invoice is recorded once the customer has accepted the quote. This quote is @StatusText.Label(q.Status).ToLowerInvariant().</p>
                <a class="btn btn-secondary" asp-action="Costing" asp-route-id="@q.Id">Back to the costing sheet</a>
            </div>
        </section>
    }

    <section class="card" aria-labelledby="why-title">
        <div class="card-head"><h2 id="why-title">Why this is recorded</h2></div>
        <div class="card-body small">
            <p class="mb-0">Sage Pastel stays the book of record for invoices. Recording the number here links the quote to its invoice, so either can be found from the other, and shows any difference between what was quoted and what was invoiced.</p>
        </div>
    </section>
</div>
