@model TechnoSurfacesApp.Controllers.VersionsVm
@*
    Every version of a quote, newest first (US-20, US-21). A revision after a
    counter offer is a new version of the same quote, not a new quote. Earlier
    versions are locked and stay readable.
*@
@using TechnoSurfaces.Application.Auditing
@{
    var q = Model.Quote;
    var a = Model.Actions;
}

<header class="page-head">
    <div>
        <h1>Version history</h1>
        <p>@q.Reference for @q.CustomerName. @Model.Versions.Count version@(Model.Versions.Count == 1 ? "" : "s").</p>
    </div>
</header>

<partial name="_QuoteHeader" model="q" />
<partial name="_QuoteTabs" model="q" />

<div class="grid grid-main">
    <section class="card" aria-labelledby="versions-title">
        <div class="card-head">
            <svg class="ico" aria-hidden="true"><use href="#i-history" /></svg>
            <h2 id="versions-title">Versions</h2>
        </div>
        <div class="card-body">
            <ol class="timeline" reversed>
                @foreach (var v in Model.Versions)
                {
                    var current = v.VersionNo == q.VersionNo;
                    <li class="tl-item @(current ? "current" : null)">
                        <span class="tl-dot" aria-hidden="true">@v.VersionNo</span>
                        <div class="tl-head">
                            <h3 class="tl-title">Version @v.VersionNo</h3>
                            @if (current)
                            {
                                <span class="badge badge-info">Current</span>
                            }
                            @if (v.IsSealed)
                            {
                                <span class="badge">
                                    <svg class="ico ico-sm" aria-hidden="true"><use href="#i-lock" /></svg> Locked
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-good">Open for changes</span>
                            }
                            <span class="tl-total">@Fmt.Rand(v.TotalExVat) <span class="sub">ex VAT</span></span>
                        </div>
                        <p class="small muted mb-0">
                            Started @Fmt.DateTimeShort(AuditTime.ToLocal(v.CreatedAtUtc)) by @v.CreatedByName.
                            Markup @Fmt.Pct(v.MarkupPercent). @Fmt.Rand(v.TotalIncVat) including VAT.
                        </p>
                        @if (current)
                        {
                            <p class="small mb-0">
                                <a asp-action="Costing" asp-route-id="@q.Id">Open the costing sheet</a>
                                <span aria-hidden="true">·</span>
                                <a asp-action="Quotation" asp-route-id="@q.Id">Open the customer quotation</a>
                            </p>
                        }
                    </li>
                }
            </ol>
        </div>
    </section>

    <div class="stack-gap">
        <section class="card" aria-labelledby="about-versions-title">
            <div class="card-head"><h2 id="about-versions-title">How versions work</h2></div>
            <div class="card-body small">
                <p>A version is locked when it is approved. From then on it reads exactly as it was issued, even if a price or a term changes later.</p>
                <p class="mb-0">When a customer asks for changes, reopen the quote. The sent version stays as it was and the next version starts as a copy you can change, then goes through approval again.</p>
            </div>
        </section>

        <partial name="_QuoteActions" model="new TechnoSurfacesApp.Controllers.QuoteActionBar(q, a, null)" />
    </div>
</div>
