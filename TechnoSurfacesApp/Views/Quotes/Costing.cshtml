@model TechnoSurfacesApp.Controllers.CostingVm
@*
    The costing sheet: the internal workings behind a quote. The material choice
    narrows step by step (US-01), the price fills in with where it came from
    (NFR-01) and the sheet size beside it (US-02). A price that cannot be found
    blocks the line and says why (US-03). Every change is saved through the costing
    API by costing.js, and the totals panel announces the new figures.
*@
@{
    var q = Model.Quote;
    var a = Model.Actions;
    var t = Model.Sheet.Totals;
    var lines = new TechnoSurfacesApp.Controllers.CostingLinesVm(Model.Sheet, a.CanEdit);
    var randPerM2 = t.TotalAreaM2 > 0 ? Fmt.Rand(t.TotalExVat / t.TotalAreaM2) : "Not yet";

    string? lockedReason = a.CanEdit ? null
        : q.IsSealed ? $"Version {q.VersionNo} is locked because it has been approved. To change it, reopen the quote as a new version."
        : q.Status == "PendingApproval" ? "This quote is waiting for approval. Only the Managing Director can change it now."
        : $"Only {q.AuthorName}, who wrote this quote, or the Managing Director can change it.";
}

<header class="page-head">
    <div>
        <h1>Costing sheet</h1>
        <p>@q.Reference for @q.CustomerName. Version @q.VersionNo.</p>
    </div>
    <div class="page-head-actions">
        <a class="btn btn-secondary" asp-action="Quotation" asp-route-id="@q.Id">
            <svg class="ico" aria-hidden="true"><use href="#i-file" /></svg> Customer quotation
        </a>
    </div>
</header>

<partial name="_QuoteHeader" model="q" />
<partial name="_QuoteTabs" model="q" />

<div class="notice notice-info" role="note">
    <svg class="ico" aria-hidden="true"><use href="#i-lock" /></svg>
    <div>
        <strong>For Techno Surfaces only.</strong>
        Cost prices, supplier discounts and the markup appear on this sheet. None of them reach the customer quotation.
    </div>
</div>

@if (lockedReason is not null)
{
    <div class="notice notice-warn" role="note">
        <svg class="ico" aria-hidden="true"><use href="#i-info" /></svg>
        <div><strong>Read only.</strong> @lockedReason</div>
    </div>
}

<div class="grid grid-main" id="costing"
     data-quote="@q.Id"
     data-api="@Url.Content($"~/api/quotes/{q.Id}/")"
     data-catalogue="@Url.Content("~/api/catalogue/")"
     data-lines-url="@Url.Action("CostingLines", new { id = q.Id })"
     data-price-url="@Url.Action("PricePreview", new { id = q.Id })"
     data-rate-url="@Url.Action("RatePreview", new { id = q.Id })">

    <div class="stack-gap">

        @* ---------------- Materials ---------------- *@
        <section class="card" aria-labelledby="materials-title">
            <div class="card-head">
                <svg class="ico" aria-hidden="true"><use href="#i-layers" /></svg>
                <h2 id="materials-title">Materials</h2>
            </div>

            @if (a.CanEdit)
            {
                <form class="card-body cascade" id="add-material" novalidate data-no-busy aria-labelledby="add-material-title">
                    <h3 id="add-material-title" class="section-label">Add a material</h3>
                    <p class="hint">Each choice narrows the next. The price fills in from the supplier's own price list as at the quote date.</p>
                    <p class="sr-only" id="cascade-status" role="status" aria-live="polite"></p>

                    <div class="field-row field-row-4">
                        <div class="field cascade-step">
                            <label class="label" for="supplier"><span class="step-no" aria-hidden="true">1</span>Supplier</label>
                            <select class="select" id="supplier" name="supplierId" required>
                                <option value="">Choose a supplier</option>
                                @foreach (var s in Model.Suppliers)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div class="field cascade-step">
                            <label class="label" for="product-line"><span class="step-no" aria-hidden="true">2</span>Product line</label>
                            <select class="select" id="product-line" name="productLineId" required disabled>
                                <option value="">Choose a supplier first</option>
                            </select>
                        </div>
                        <div class="field cascade-step">
                            <label class="label" for="colour"><span class="step-no" aria-hidden="true">3</span>Colour</label>
                            <select class="select" id="colour" name="colourId" required disabled>
                                <option value="">Choose a product line first</option>
                            </select>
                        </div>
                        <div class="field cascade-step">
                            <label class="label" for="sheet-size"><span class="step-no" aria-hidden="true">4</span>Sheet size</label>
                            <select class="select" id="sheet-size" name="sheetSizeId" required disabled>
                                <option value="">Choose a colour first</option>
                            </select>
                        </div>
                    </div>

                    @* The price, where it came from and the sheet size, or the reason there is no price. *@
                    <div id="material-price"></div>

                    <div class="field-row field-row-3 cascade-qty">
                        <div class="field">
                            <label class="label" for="material-quantity">Sheets</label>
                            <input class="input input-num" id="material-quantity" name="quantity" type="number"
                                   inputmode="decimal" min="0" step="any" required value="1" />
                        </div>
                        <div class="field">
                            <label class="label" for="material-discount">Supplier discount <span class="optional">optional</span></label>
                            <span class="input-group">
                                <input class="input input-num" id="material-discount" name="supplierDiscountPercent" type="number"
                                       inputmode="decimal" min="0" max="100" step="any" value="0" aria-describedby="material-discount-hint" />
                                <span class="addon" aria-hidden="true">%</span>
                            </span>
                            <span class="hint" id="material-discount-hint">A discount the supplier gives on this order.</span>
                        </div>
                        <div class="field field-action">
                            <button type="submit" class="btn btn-primary btn-block" id="add-material-button" disabled aria-describedby="add-material-why">
                                <svg class="ico" aria-hidden="true"><use href="#i-plus" /></svg> Add to the costing
                            </button>
                            <span class="hint" id="add-material-why">Choose all four steps to see the price.</span>
                        </div>
                    </div>
                </form>
            }

            <partial name="_MaterialLines" model="lines" />
        </section>

        @* ---------------- Labour, consumables and extras ---------------- *@
        <section class="card" aria-labelledby="rates-title">
            <div class="card-head">
                <svg class="ico" aria-hidden="true"><use href="#i-calc" /></svg>
                <h2 id="rates-title">Labour, consumables and extras</h2>
            </div>

            <partial name="_RateLines" model="lines" />

            @if (a.CanEdit)
            {
                <form class="card-body card-body-top" id="add-rate" novalidate data-no-busy aria-labelledby="add-rate-title">
                    <h3 id="add-rate-title" class="section-label">Add from the rate card</h3>
                    <div class="field-row field-row-3">
                        <div class="field">
                            <label class="label" for="rate-item">Item</label>
                            <select class="select" id="rate-item" name="rateItemId" required>
                                <option value="">Choose an item</option>
                                @foreach (var group in Model.RateItems.GroupBy(r => r.Category))
                                {
                                    <optgroup label="@Words.Humanise(group.Key)">
                                        @foreach (var r in group)
                                        {
                                            <option value="@r.Id" data-unit="@Words.Unit(r.Unit)" data-derived="@Words.Derivation(r.Derivation)"
                                                    data-below="@(r.IsBelowTheLine ? "true" : null)">@r.Name</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label class="label" for="rate-quantity">Quantity</label>
                            <input class="input input-num" id="rate-quantity" name="quantity" type="number"
                                   inputmode="decimal" min="0" step="any" required value="1" aria-describedby="rate-quantity-hint" />
                            <span class="hint" id="rate-quantity-hint">How many, in the item's unit.</span>
                        </div>
                        <div class="field" id="rate-price-field" hidden>
                            <label class="label" for="rate-price">Price for this job</label>
                            <span class="input-group">
                                <span class="addon before" aria-hidden="true">R</span>
                                <input class="input input-num" id="rate-price" name="unitPrice" type="number"
                                       inputmode="decimal" min="0.01" step="any" aria-describedby="rate-price-hint" />
                            </span>
                            <span class="hint" id="rate-price-hint">The rate card has no price for this item yet, so enter the price for this job.</span>
                        </div>
                    </div>

                    <div id="rate-preview"></div>

                    <div class="btn-row">
                        <button type="submit" class="btn btn-primary" id="add-rate-button" disabled aria-describedby="add-rate-why">
                            <svg class="ico" aria-hidden="true"><use href="#i-plus" /></svg> Add to the costing
                        </button>
                        <span class="hint" id="add-rate-why">Choose an item to see its rate.</span>
                    </div>
                </form>
            }
        </section>
    </div>

    @* ---------------- Totals and next step ---------------- *@
    <div class="stack-gap">
        <section class="card totals" id="totals" aria-labelledby="totals-title">
            <div class="card-head">
                <h2 id="totals-title">Totals</h2>
                <span class="spacer"></span>
                @if (a.CanEdit)
                {
                    <span class="save-state" id="save-state" data-state="saved">
                        <svg class="ico ico-sm" aria-hidden="true"><use href="#i-check" /></svg>
                        <span data-save-text>All changes saved</span>
                    </span>
                }
            </div>
            <div class="card-body">
                <div class="totals-row">
                    <span class="lbl">Sub total</span>
                    <span class="val" data-total="subTotalExVat">@Fmt.Rand(t.SubTotalExVat)</span>
                </div>
                <div class="totals-row">
                    <span class="lbl">
                        @if (a.CanEdit)
                        {
                            <label for="markup">Markup</label>
                            <span class="input-group input-group-sm input-inline">
                                <input class="input input-sm input-num" id="markup" type="number" inputmode="decimal" min="0" max="999.99" step="any"
                                       required value="@Fmt.Input(t.MarkupPercent)" data-costing-field="markupPercent" data-saved="@Fmt.Input(t.MarkupPercent)"
                                       aria-describedby="markup-hint" />
                                <span class="addon" aria-hidden="true">%</span>
                            </span>
                        }
                        else
                        {
                            @:Markup @Fmt.Pct(t.MarkupPercent)
                        }
                    </span>
                    <span class="val" data-total="markupAmount">@Fmt.Rand(t.MarkupAmount)</span>
                </div>
                <div class="totals-row">
                    <span class="lbl">
                        @if (a.CanEdit)
                        {
                            <label for="transport">Transport</label>
                            <span class="input-group input-group-sm input-inline">
                                <span class="addon before" aria-hidden="true">R</span>
                                <input class="input input-sm input-num" id="transport" type="number" inputmode="decimal" min="0" step="any"
                                       required value="@Fmt.Input(t.TransportAmount)" data-costing-field="transportAmount" data-saved="@Fmt.Input(t.TransportAmount)" />
                            </span>
                        }
                        else
                        {
                            @:Transport
                        }
                    </span>
                    <span class="val" data-total="transportAmount">@Fmt.Rand(t.TransportAmount)</span>
                </div>
                <div class="totals-row">
                    <span class="lbl">Cut-outs, grooves and transport</span>
                    <span class="val" data-total="belowTheLineTotal">@Fmt.Rand(t.BelowTheLineTotal)</span>
                </div>
                <div class="totals-row total-line">
                    <span class="lbl">Total ex VAT</span>
                    <span class="val" data-total="totalExVat">@Fmt.Rand(t.TotalExVat)</span>
                </div>
                <div class="totals-row">
                    <span class="lbl">VAT at <span data-total="vatRate" data-format="rate">@Fmt.Pct(t.VatRate * 100)</span></span>
                    <span class="val" data-total="vatAmount">@Fmt.Rand(t.VatAmount)</span>
                </div>
                <div class="totals-row grand">
                    <span class="lbl">Total inc VAT</span>
                    <span class="val" data-total="totalIncVat">@Fmt.Rand(t.TotalIncVat)</span>
                </div>

                <dl class="facts facts-tight">
                    <dt>Total area</dt>
                    <dd data-total="totalAreaM2" data-format="area">@Fmt.Sqm(t.TotalAreaM2)</dd>
                    <dt>Sheets</dt>
                    <dd data-total="totalSheetCount" data-format="quantity">@Fmt.Qty(t.TotalSheetCount)</dd>
                    <dt>Rand per m², ex VAT</dt>
                    <dd data-total="randPerM2">@randPerM2</dd>
                </dl>

                <p class="totals-note" id="markup-hint">
                    The markup applies to the sub total only. Cut-outs, grooves and transport are added after it, at cost, as the client confirmed.
                </p>

                @* Read out by a screen reader after every recalculation. *@
                <p class="sr-only" id="totals-status" role="status" aria-live="polite" aria-atomic="true"></p>
            </div>
        </section>

        <partial name="_CostingSide" model="new TechnoSurfacesApp.Controllers.QuoteActionBar(q, a, Model.Check)" />
    </div>
</div>

@section Scripts {
    <script src="~/js/costing.js" asp-append-version="true"></script>
}
