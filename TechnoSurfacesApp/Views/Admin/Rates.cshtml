@model TechnoSurfacesApp.Controllers.RatesVm
@*
    The rate card (US-06, US-23): labour, consumables, wood and extras, held once and
    used on every quote. A new rate starts on a date, so quotes already made keep the
    rate they were made with. Only the Managing Director changes a rate.
*@

<header class="page-head">
    <div>
        <h1>Rate card</h1>
        <p>The labour, consumable and extra rates every quote uses. Change a rate here once and new quotes pick it up.</p>
    </div>
</header>

@if (!Model.CanEdit)
{
    <partial name="_ReadOnlyNote" model="@("Only the Managing Director changes rates. You can see every rate the costing sheet uses.")" />
}

@{
    var notSupplied = Model.Groups.Sum(g => g.Rows.Count(r => r.AwaitingClientFigure));
}
<div class="notice notice-warn" role="note">
    <svg class="ico" aria-hidden="true"><use href="#i-alert" /></svg>
    <div>
        <strong>These rates are not confirmed yet.</strong>
        They are the sample figures from the client's costing workbook, which the client supplied to show the layout of a quote, not their real rates.
        @if (notSupplied > 0)
        {
            <text>@notSupplied line@(notSupplied == 1 ? " has" : "s have") no figure at all, so the costing sheet asks for a price for each job.</text>
        }
        The Managing Director replaces each rate here once the real figures are known.
    </div>
</div>

@foreach (var (category, rows) in Model.Groups)
{
    var id = "rates-" + category.ToLowerInvariant();
    <section class="card mb-section" aria-labelledby="@id">
        <div class="card-head">
            <h2 id="@id">@Words.Humanise(category)</h2>
            <span class="spacer"></span>
            <span class="muted small">@rows.Count item@(rows.Count == 1 ? "" : "s")</span>
        </div>
        <div class="table-wrap">
            <table class="data stack">
                <caption class="sr-only">@Words.Humanise(category) rates</caption>
                <thead>
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col">Charged</th>
                        <th scope="col" class="right">Rate, ex VAT</th>
                        <th scope="col">Since</th>
                        @if (Model.CanEdit)
                        {
                            <th scope="col"><span class="sr-only">Change</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        var derived = Model.DerivedAmount(r);
                        <tr>
                            <td data-label="Item">
                                <span class="strong">@r.Name</span>
                                @if (r.Supplier is not null)
                                {
                                    <span class="sub">For @r.Supplier material</span>
                                }
                                @if (r.IsDerived)
                                {
                                    <span class="sub">@((r.Multiplier ?? 1m) == 1m ? $"Same rate as {r.DerivedFrom}" : $"Worked out as {Fmt.Qty(r.Multiplier!.Value)} times {r.DerivedFrom}")</span>
                                }
                            </td>
                            <td data-label="Charged">@Words.Unit(r.Unit)</td>
                            <td data-label="Rate, ex VAT" class="right num">
                                @if (r.Amount is { } amount)
                                {
                                    <span class="strong">@Fmt.Rand(amount)</span>
                                }
                                else if (derived is { } worked)
                                {
                                    <span class="strong">@Fmt.Rand(worked)</span>
                                }
                                else if (r.AwaitingClientFigure)
                                {
                                    <span class="badge badge-warn">Not supplied yet</span>
                                }
                            </td>
                            <td data-label="Since" class="nowrap">@(r.From is { } from ? Fmt.Date(from) : r.IsDerived ? "Follows its base rate" : "")</td>
                            @if (Model.CanEdit)
                            {
                                <td data-label="Change" class="right">
                                    @if (!r.IsDerived)
                                    {
                                        var formId = $"rate-{r.RateItemId}-{r.SupplierId}";
                                        <details class="disclosure">
                                            <summary class="btn btn-ghost btn-sm">
                                                <svg class="ico ico-sm" aria-hidden="true"><use href="#i-edit" /></svg>
                                                Change<span class="sr-only"> the rate for @r.Name@(r.Supplier is null ? "" : $", {r.Supplier}")</span>
                                            </summary>
                                            <form class="disclosure-body row-edit" method="post" asp-controller="Catalogue" asp-action="SetRate">
                                                <input type="hidden" name="RateItemId" value="@r.RateItemId" />
                                                <input type="hidden" name="SupplierId" value="@r.SupplierId" />
                                                <div class="field">
                                                    <label class="label" for="@formId-amount">New rate</label>
                                                    <span class="input-group">
                                                        <span class="addon before" aria-hidden="true">R</span>
                                                        <input class="input input-num" id="@formId-amount" name="Amount" type="number" step="0.01" min="0.01"
                                                               required inputmode="decimal" value="@(r.Amount is { } a ? Fmt.Input(a) : "")" />
                                                    </span>
                                                </div>
                                                <div class="field">
                                                    <label class="label" for="@formId-from">Starts on</label>
                                                    <input class="input" id="@formId-from" name="EffectiveFrom" type="date" required value="@Model.Today.ToString("yyyy-MM-dd")" />
                                                </div>
                                                <button type="submit" class="btn btn-primary">Save the rate</button>
                                            </form>
                                        </details>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
