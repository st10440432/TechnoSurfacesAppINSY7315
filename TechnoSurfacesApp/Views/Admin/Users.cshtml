@model TechnoSurfacesApp.Controllers.UsersVm
@*
    User accounts (US-26). There is no public registration: the Managing Director
    creates every account and hands over a temporary password in person. Accounts are
    deactivated, never deleted, so older quotes keep their author.
*@

<header class="page-head">
    <div>
        <h1>Users</h1>
        <p>@Model.ActiveCount active account@(Model.ActiveCount == 1 ? "" : "s"): @Model.MdCount Managing Director and @Model.EstimatorCount estimator@(Model.EstimatorCount == 1 ? "" : "s").</p>
    </div>
</header>

@if (TempData["UserMessage"] is string message)
{
    <div class="notice notice-good mb-section" role="status">
        <svg class="ico" aria-hidden="true"><use href="#i-check-circle" /></svg>
        <div>
            <strong>@message</strong>
            @if (TempData["TemporaryPassword"] is string temporary)
            {
                <p class="mb-0">Temporary password: <code class="temp-password">@temporary</code></p>
                <p class="mb-0 small">Give it to the person face to face. It is shown only this once, and they choose their own password when they first sign in.</p>
            }
        </div>
    </div>
}
@if (TempData["UserError"] is string error)
{
    <div class="notice notice-alert mb-section" role="alert">
        <svg class="ico" aria-hidden="true"><use href="#i-alert" /></svg>
        <div><strong>Not saved.</strong> @error</div>
    </div>
}

<div class="grid grid-main">
    <div class="stack-gap">
    <section class="card" aria-labelledby="accounts-title">
        <div class="card-head"><h2 id="accounts-title">Accounts</h2></div>
        <div class="table-wrap">
            <table class="data stack">
                <caption class="sr-only">User accounts</caption>
                <thead>
                    <tr>
                        <th scope="col">Person</th>
                        <th scope="col">Role</th>
                        <th scope="col">Status</th>
                        <th scope="col">Last signed in</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        var me = u.Id == Model.MyId;
                        <tr>
                            <td data-label="Person">
                                <span class="strong">@u.FullName</span>
                                @if (me) { <span class="badge badge-sage">You</span> }
                                <span class="sub">@u.Email</span>
                                @if (Model.CanManage)
                                {
                                    <div class="btn-row btn-row-tight user-actions">
                                        <form asp-action="ReissuePassword" method="post"
                                              data-confirm="Issue a new temporary password for @u.FullName?"
                                              data-confirm-detail="Their current password stops working. They choose a new one when they next sign in."
                                              data-confirm-label="Issue password">
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <button class="btn btn-secondary btn-sm" type="submit">
                                                New password<span class="sr-only"> for @u.FullName</span>
                                            </button>
                                        </form>
                                        @if (!me)
                                        {
                                            <form asp-action="SetUserActive" method="post"
                                                  data-confirm="@(u.IsActive ? "Deactivate" : "Reactivate") @u.FullName?"
                                                  data-confirm-detail="@(u.IsActive ? "They can no longer sign in. Their quotes keep their name." : "They can sign in again with their existing password.")"
                                                  data-confirm-label="@(u.IsActive ? "Deactivate" : "Reactivate")"
                                                  data-confirm-tone="@(u.IsActive ? "danger" : "")">
                                                <input type="hidden" name="userId" value="@u.Id" />
                                                <input type="hidden" name="active" value="@(!u.IsActive)" />
                                                <button class="btn btn-ghost btn-sm" type="submit">
                                                    @(u.IsActive ? "Deactivate" : "Reactivate")<span class="sr-only"> @u.FullName</span>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                            </td>
                            <td data-label="Role">@u.RoleLabel</td>
                            <td data-label="Status">
                                @if (!u.IsActive)
                                {
                                    <span class="badge">Deactivated</span>
                                }
                                else if (u.IsLockedOut)
                                {
                                    <span class="badge badge-warn">Locked out</span>
                                }
                                else
                                {
                                    <span class="badge badge-good">Active</span>
                                }
                                @if (u.MustChangePassword)
                                {
                                    <span class="sub">Has not chosen a password yet</span>
                                }
                            </td>
                            <td data-label="Last signed in" class="nowrap">
                                @(u.LastLogin.HasValue ? Fmt.DateTimeShort(u.LastLogin.Value) : "Never")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="card" aria-labelledby="who-title">
        <div class="card-head"><h2 id="who-title">Who can do what</h2></div>
        <div class="table-wrap">
            <table class="data matrix">
                <caption class="sr-only">What each role can do</caption>
                <thead>
                    <tr>
                        <th scope="col">Action</th>
                        <th scope="col">Managing Director</th>
                        <th scope="col">Estimator</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        (string Label, string Md, string Est)[] rules =
                        {
                            ("Create quotes", "Yes", "Yes"),
                            ("Change a draft quote", "Any quote", "Own drafts"),
                            ("Approve quotes", "Yes", "No"),
                            ("See every price", "Yes", "Yes"),
                            ("Change prices and rates", "Yes", "No"),
                            ("Manage user accounts", "Yes", "No"),
                        };
                    }
                    @foreach (var r in rules)
                    {
                        <tr>
                            <th scope="row">@r.Label</th>
                            <td>@r.Md</td>
                            <td>@r.Est</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
    </div>

    <div class="stack-gap">
        @if (Model.CanManage)
        {
            <section class="card" id="create-user" aria-labelledby="create-title">
                <div class="card-head">
                    <svg class="ico" aria-hidden="true"><use href="#i-plus" /></svg>
                    <h2 id="create-title">Create an account</h2>
                </div>
                <form class="card-body" asp-action="CreateUser" method="post">
                    <div class="field">
                        <label class="label" for="FullName">Full name</label>
                        <input class="input" id="FullName" name="FullName" required maxlength="200" autocomplete="off" />
                    </div>
                    <div class="field">
                        <label class="label" for="Email">Email address</label>
                        <input class="input" id="Email" name="Email" type="email" required maxlength="200" autocomplete="off" />
                    </div>
                    <div class="field">
                        <label class="label" for="Role">Role</label>
                        <select class="select" id="Role" name="Role">
                            <option value="Estimator">Estimator</option>
                            <option value="ManagingDirector">Managing Director</option>
                        </select>
                    </div>
                    <p class="hint">There is no public sign-up. The system makes a temporary password for you to hand over.</p>
                    <button class="btn btn-primary btn-block" type="submit">Create the account</button>
                </form>
            </section>
        }

    </div>
</div>
