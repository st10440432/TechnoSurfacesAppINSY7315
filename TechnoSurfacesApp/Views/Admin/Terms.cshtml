@using TermSection = TechnoSurfaces.Domain.TermSection
@model TechnoSurfacesApp.Controllers.TermsVm
@*
    The standing wording on every customer quotation (US-12, US-13), kept in one place.
    Each line saves on its own. An approved quote keeps the wording it was issued
    with, so a change here only affects quotations from now on.
*@
@functions {
    private static string SectionName(TermSection s) => s switch
    {
        TermSection.Notes => "Notes",
        TermSection.LeadTimes => "Lead times",
        TermSection.Exclusions => "Exclusions",
        TermSection.TermsAndConditions => "Terms and conditions",
        TermSection.Disclaimers => "Disclaimers",
        TermSection.Warranties => "Warranties",
        TermSection.PaymentTerms => "Payment terms",
        TermSection.BankDetails => "Bank details",
        _ => s.ToString()
    };
}

<header class="page-head">
    <div>
        <h1>Quotation terms</h1>
        <p>The wording printed on every customer quotation. A quote that is already approved keeps the wording it was issued with.</p>
    </div>
</header>

@if (!Model.CanEdit)
{
    <partial name="_ReadOnlyNote" model="@("Only the Managing Director changes the quotation terms. This is the wording quotations print.")" />
}

<div class="grid grid-main">
    <div class="stack-gap">
        @foreach (var part in Enum.GetValues<TermSection>())
        {
            var active = Model.ActiveIn(part);
            var retired = Model.RetiredIn(part);
            var key = part.ToString().ToLowerInvariant();

            <section class="card" aria-labelledby="terms-@key">
                <div class="card-head">
                    <h2 id="terms-@key">@SectionName(part)</h2>
                </div>
                <div class="card-body">
                    @if (part == TermSection.BankDetails && active.Count == 0)
                    {
                        <div class="notice notice-warn" role="note">
                            <svg class="ico" aria-hidden="true"><use href="#i-alert" /></svg>
                            <div><strong>Bank details are not set.</strong> Quotations say so until they are added below.</div>
                        </div>
                    }
                    else if (active.Count == 0)
                    {
                        <p class="muted">No lines in this section.</p>
                    }

                    @for (var i = 0; i < active.Count; i++)
                    {
                        var line = active[i];
                        if (Model.CanEdit)
                        {
                            <div class="term-line">
                                <form asp-controller="Catalogue" asp-action="UpdateTerm" method="post" id="term-@line.Id">
                                    <input type="hidden" name="TermId" value="@line.Id" />
                                    <label class="label" for="term-@line.Id-text">Line @(i + 1)</label>
                                    <textarea class="input" id="term-@line.Id-text" name="Text" rows="2" maxlength="500" required>@line.Text</textarea>
                                </form>
                                <div class="btn-row btn-row-tight">
                                    <button class="btn btn-secondary btn-sm" type="submit" form="term-@line.Id">
                                        Save<span class="sr-only"> line @(i + 1) of @SectionName(part)</span>
                                    </button>
                                    <form asp-controller="Catalogue" asp-action="RetireTerm" method="post"
                                          data-confirm="Retire this line?" data-confirm-label="Retire"
                                          data-confirm-detail="It stops printing on new quotations. Approved quotes keep it.">
                                        <input type="hidden" name="termId" value="@line.Id" />
                                        <button class="btn btn-ghost btn-sm" type="submit">
                                            Retire<span class="sr-only"> line @(i + 1) of @SectionName(part)</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="term-text">@line.Text</p>
                        }
                    }

                    @if (Model.CanEdit)
                    {
                        <form class="term-add" asp-controller="Catalogue" asp-action="AddTerm" method="post">
                            <input type="hidden" name="Section" value="@(part)" />
                            <div class="field">
                                <label class="label" for="add-@key">Add a line to @SectionName(part)</label>
                                <div class="field-row-action">
                                    <input class="input" id="add-@key" name="Text" maxlength="500" required />
                                    <button class="btn btn-secondary" type="submit">Add<span class="sr-only"> to @SectionName(part)</span></button>
                                </div>
                            </div>
                        </form>
                    }

                    @if (retired.Count > 0)
                    {
                        <details class="disclosure term-retired">
                            <summary class="btn btn-ghost btn-sm">@retired.Count retired line@(retired.Count == 1 ? "" : "s")</summary>
                            <ul>
                                @foreach (var line in retired)
                                {
                                    <li class="muted">@line.Text</li>
                                }
                            </ul>
                        </details>
                    }
                </div>
            </section>
        }
    </div>

    <div class="stack-gap">
        <section class="card" aria-labelledby="brands-title">
            <div class="card-head"><h2 id="brands-title">Warranty by brand</h2></div>
            <div class="card-body">
                <p class="hint">A brand with no warranty here prints none on its quotations, rather than a guess. Clear both boxes to remove one.</p>
                @if (Model.Brands.Count == 0)
                {
                    <p class="muted">No brands in the catalogue yet.</p>
                }
                @foreach (var b in Model.Brands)
                {
                    <div class="brand-warranty">
                        <h3>@b.Name <span class="muted small">(@b.ProductLineCount product line@(b.ProductLineCount == 1 ? "" : "s"))</span></h3>
                        @if (Model.CanEdit)
                        {
                            <form class="row-edit" asp-controller="Catalogue" asp-action="SetBrandWarranty" method="post">
                                <input type="hidden" name="BrandId" value="@b.Id" />
                                <div class="field">
                                    <label class="label" for="brand-@b.Id-material">Material</label>
                                    <input class="input" id="brand-@b.Id-material" name="MaterialWarranty" value="@b.MaterialWarranty" maxlength="60" />
                                </div>
                                <div class="field">
                                    <label class="label" for="brand-@b.Id-work">Workmanship</label>
                                    <input class="input" id="brand-@b.Id-work" name="WorkmanshipWarranty" value="@b.WorkmanshipWarranty" maxlength="60" />
                                </div>
                                <button class="btn btn-secondary" type="submit">Save<span class="sr-only"> the @b.Name warranty</span></button>
                            </form>
                        }
                        else
                        {
                            <p class="mb-0">
                                @(b.HasWarranty
                                    ? $"{b.MaterialWarranty} on the material, {b.WorkmanshipWarranty} on workmanship."
                                    : "No warranty confirmed, so none is printed.")
                            </p>
                        }
                    </div>
                }
            </div>
        </section>
    </div>
</div>
