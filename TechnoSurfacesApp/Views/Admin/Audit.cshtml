@using TechnoSurfaces.Application.Auditing
@model TechnoSurfacesApp.Controllers.AuditVm

<div class="page-head">
    <div>
        <h2>Audit trail</h2>
        <p>
            @Model.TotalMatching entr@(Model.TotalMatching == 1 ? "y" : "ies")@if (Model.AnyFilter) {
            <text> matching your filters</text>
        }
        @if (Model.Truncated)
        {
            <text> &middot; showing the newest @Model.Entries.Count</text>
        }
    </p>
</div>
</div>

<div class="notice notice-info">
    <svg class="ico"><use href="#i-info" /></svg>
    <div>
        <strong>Why this matters more than it looks.</strong>
        Approval has no rejection path &mdash; the Managing Director corrects an estimator's figures
        and approves in one step, silently. This trail is the only place that correction becomes
        visible to the person who wrote the quote. Entries cannot be edited or deleted.
    </div>
</div>

<div class="grid grid-3" style="margin-bottom:20px">
    <div class="tile tile-accent">
        <div class="tile-label">Matching entries</div>
        <div class="tile-value">@Model.TotalMatching</div>
        <div class="tile-note">insert-only, never edited</div>
    </div>
    <div class="tile tile-accent amber">
        <div class="tile-label">Price &amp; rate changes</div>
        <div class="tile-value">@Model.PriceChangeCount</div>
        <div class="tile-note">of the rows shown</div>
    </div>
    <div class="tile tile-accent blue">
        <div class="tile-label">Contributors</div>
        <div class="tile-value">@Model.Users.Count</div>
        <div class="tile-note">users with recorded changes</div>
    </div>
</div>

<div class="card">
    <form method="get" class="filterbar">
        <select class="select" name="user" onchange="this.form.submit()" aria-label="User">
            <option value="">All users</option>
            @foreach (var u in Model.Users)
            {
                <option value="@u.UserId" selected="@(Model.Filter.UserId == u.UserId)">@u.Name</option>
            }
        </select>

        <select class="select" name="type" onchange="this.form.submit()" aria-label="Entity type">
            <option value="">All entity types</option>
            @foreach (var t in Model.EntityTypes)
            {
                <option value="@t" selected="@(Model.Filter.EntityName == t)">@t</option>
            }
        </select>

        <input class="input" type="date" name="from" value="@Model.FromValue" aria-label="From date" />
        <input class="input" type="date" name="to" value="@Model.ToValue" aria-label="To date" />

        <label class="check" style="margin:0">
            <input type="checkbox" name="priceOnly" value="true"
                   checked="@Model.Filter.PriceOnly" onchange="this.form.submit()" />
            <span class="small">Price and rate changes only</span>
        </label>

        <button type="submit" class="btn btn-sm">Apply</button>

        @if (Model.AnyFilter)
        {
            <a class="btn btn-ghost btn-sm" asp-action="Audit">Clear</a>
        }
    </form>

    @if (Model.Entries.Count == 0)
    {
        <div class="empty">
            <svg class="ico"><use href="#i-history" /></svg>
            <h3>Nothing matches</h3>
            <p>@(Model.AnyFilter ? "Try widening the filters." : "No changes have been recorded yet.")</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data stack">
                <thead>
                    <tr>
                        <th>When (SAST)</th>
                        <th>Who</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Change</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Entries)
                    {
                        <tr>
                            <td data-label="When" class="small nowrap">@Fmt.DateTimeShort(a.ChangedAtLocal)</td>
                            <td data-label="Who">
                                <div style="display:flex;align-items:center;gap:7px">
                                    <span class="avatar" style="width:22px;height:22px;flex-basis:22px;font-size:.56rem">
                                        @string.Concat(a.UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]))
                                    </span>
                                    <span class="small">@a.UserName</span>
                                </div>
                            </td>
                            <td data-label="Action" class="small">
                                @a.Action
                                @if (a.IsPriceChange)
                                {
                                    <span class="badge badge-warn">Price</span>
                                }
                            </td>
                            <td data-label="Entity">
                                <span class="badge">@a.EntityName</span>
                                <div class="tiny muted" style="margin-top:2px">#@a.EntityKey</div>
                            </td>
                            <td data-label="Change" class="small">
                                @if (a.IsDeletion)
                                {
                                    <span class="muted">Row removed</span>
                                }
                                else
                                {
                                    <span class="muted">@a.PropertyName:</span>
                                    @if (a.OldValue is not null)
                                    {
                                        <span style="text-decoration:line-through;color:var(--ink-3)">@a.OldValue</span>
                                        <span class="muted">&rarr;</span>
                                    }
                                    <strong>@a.NewValue</strong>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>