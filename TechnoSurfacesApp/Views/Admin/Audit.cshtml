@model TechnoSurfacesApp.Controllers.AuditVm
@*
    The audit trail (NFR-04, US-19): every change to a quote, a price, a rate or an
    account, written as a sentence, newest first. Entries cannot be edited or deleted.
*@
@{
    var stories = ChangeStories.From(Model.Entries);
}

<header class="page-head">
    <div>
        <h1>Audit trail</h1>
        <p>Every change made in the system, newest first. Entries cannot be edited or deleted.</p>
    </div>
</header>

<section class="card" aria-labelledby="audit-title">
    <h2 class="sr-only" id="audit-title">Changes</h2>

    <form class="filters" method="get" asp-action="Audit" role="search" aria-label="Filter the audit trail" data-no-busy>
        <div class="field">
            <label class="label" for="user">Who</label>
            <select class="select" id="user" name="user">
                <option value="">Everyone</option>
                @foreach (var u in Model.Users)
                {
                    <option value="@u.UserId" selected="@(Model.Filter.UserId == u.UserId)">@u.Name</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="label" for="type">What was changed</label>
            <select class="select" id="type" name="type">
                <option value="">Everything</option>
                @foreach (var t in Model.EntityTypes.OrderBy(ChangeStories.RecordName))
                {
                    <option value="@t" selected="@(Model.Filter.EntityName == t)">@ChangeStories.RecordName(t)</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="label" for="from">From</label>
            <input class="input" type="date" id="from" name="from" value="@Model.FromValue" />
        </div>
        <div class="field">
            <label class="label" for="to">To</label>
            <input class="input" type="date" id="to" name="to" value="@Model.ToValue" />
        </div>
        <div class="field check filter-check">
            <input type="checkbox" id="priceOnly" name="priceOnly" value="true" checked="@Model.Filter.PriceOnly" />
            <label for="priceOnly">Price and rate changes only</label>
        </div>
        <div class="btn-row">
            <button type="submit" class="btn btn-secondary">Show changes</button>
            @if (Model.AnyFilter)
            {
                <a class="btn btn-ghost" asp-action="Audit">Clear</a>
            }
        </div>
    </form>

    <div class="card-body">
        <p class="list-count" role="status">
            @stories.Count change@(stories.Count == 1 ? "" : "s")@(Model.AnyFilter ? " match the filters" : "")@(Model.Truncated ? $", from the newest {Model.Entries.Count} recorded values" : "").
        </p>

        @if (stories.Count == 0)
        {
            <div class="empty">
                <svg class="ico" aria-hidden="true"><use href="#i-history" /></svg>
                <h3>Nothing matches</h3>
                <p>@(Model.AnyFilter ? "Widen the dates or choose Everyone and Everything." : "No changes have been recorded yet.")</p>
            </div>
        }
        else
        {
            <ol class="changes">
                @foreach (var s in stories)
                {
                    <partial name="_ChangeStory" model="s" />
                }
            </ol>
        }
    </div>
</section>
